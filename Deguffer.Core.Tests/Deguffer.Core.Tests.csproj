<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deguffer.Core\Deguffer.Core.csproj" />
    <ProjectReference Include="..\Deguffer.Testing\Deguffer.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The build step Directory.Build.targets compiles as an inline task, compiled here as well so its
    rules are tested (LargeAddressAwareImageTests). Microsoft.Build.Framework declares the interface
    the task implements, at the version of the MSBuild in the .NET 10 SDK: 18.10 and later target
    only net11.
  -->
  <ItemGroup>
    <Compile Include="..\build\MarkLargeAddressAware.cs" Link="Build\MarkLargeAddressAware.cs" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" />
  </ItemGroup>

</Project>
