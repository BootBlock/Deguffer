<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="Deguffer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Deguffer.App.Shell">

    <Grid RowDefinitions="Auto,*">
        <!--
            The window's own ground, shown wherever the Acrylic material is not: the solid colour
            §6.5 has the UI read on. Under everything, so turning the material on or off fades this
            rather than repainting the window. WindowBackdrop sets how much of it shows.
        -->
        <Border x:Name="Ground" Grid.RowSpan="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <!--
            §6.5: the content extends into the title bar so the material runs the full height.
            This row is the drag region, and carries nothing but the app name — no information
            is placed where it would depend on the backdrop being present.

            The platform's TitleBar rather than a row drawn here: it is as tall as the caption
            buttons beside it, so the name lines up with their glyphs, and it dims its name and icon
            while the window is in the background, as Windows dims its own (#928).
        -->
        <TitleBar x:Name="TitleBar" Grid.Row="0" Title="{x:Bind shell:DestinationNames.Application}">
            <TitleBar.IconSource>
                <!-- Decoded at the size it is drawn: the source is the 256px master, and without
                     this the full bitmap is decoded to fill a 16px slot. -->
                <ImageIconSource>
                    <ImageIconSource.ImageSource>
                        <BitmapImage UriSource="ms-appx:///Assets/Deguffer-256.png"
                                     DecodePixelWidth="16" DecodePixelHeight="16" />
                    </ImageIconSource.ImageSource>
                </ImageIconSource>
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            A rail with its labels showing on a wide window, so nothing has to be opened to find out
            what is here, and folded to its icons, each named by its tooltip, on a narrow one, so the
            page keeps the width. Its toggle overrides the fold for a reader who wants the labels or
            the width at every size, and the window remembers that choice (RailFolding). Left mode at
            every width, so it never overlays the page: the closed rail in Left mode is the compact
            strip, not a hidden pane.

            A one-word label cannot say what question its page answers, and Storage and Explore both
            sound like disk space. So every item carries that question as its help text, and as a
            tooltip that leads with the label, because the tooltip is the only name a collapsed item
            shows. DesignRailTests holds the two to each other.

            Its back button starts hidden and is shown only while a link from one page to another
            has somewhere to return to (LinkHistory, BackGestures). The rail itself is no history.
        -->
        <NavigationView x:Name="Navigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="184"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        Background="Transparent"
                        SelectionChanged="OnDestinationChanged">

            <NavigationView.MenuItems>
                <!-- Which item starts selected is set in the window's constructor rather than
                     here. A markup IsSelected stays true on the item after the rail has been moved
                     elsewhere, so the rail would report two items selected. Each item is routed to
                     its page by the item itself, in MainWindow's tables, not by a Tag. Its label and
                     the tooltip that leads with it are given there from DestinationNames, the name its
                     page's header and the window title read; only its help text is written here. -->

                <!-- The drives: what is on them, what can go, and what state they are in. Storage
                     first, because it is the task the window exists for and where it opens. A
                     header's words are hidden with the rail collapsed, which is why the groups are
                     also parted by a separator. -->
                <NavigationViewItemHeader Content="Drives" />

                <NavigationViewItem x:Name="StorageItem"
                                    AutomationProperties.HelpText="Clean caches and build output that are safe to remove">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Explore answers "what is using the space"; Storage answers "what is safe to
                     remove". §3 is entirely about those being different questions, so they are
                     different destinations rather than two views of one screen. -->
                <NavigationViewItem x:Name="ExploreItem"
                                    AutomationProperties.HelpText="See where the space on a drive went">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Duplicates answers "which files are on this disk more than once" (§7.4). Its own
                     destination for the reason Explore is one: it ranks and matches, and a match
                     says nothing about whether a copy is safe to remove. It removes only copies the
                     user marked, and every group keeps one. -->
                <NavigationViewItem x:Name="DuplicatesItem"
                                    AutomationProperties.HelpText="Find files that are on a drive more than once">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Health answers "what state are the drives in" (§7.6). With the disk pages because
                     Storage, Explore and Duplicates name a drive of concern from what it read. It
                     reads and explains, and sends a drive nothing that could change it. Built on the
                     first visit, so nothing asks a drive anything until then. -->
                <NavigationViewItem x:Name="HealthItem"
                                    AutomationProperties.HelpText="See what state each drive reports it is in">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE95E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- The programs: what is installed, what starts at sign-in, and what runs now. The
                     separator keeps the two groups apart with the rail collapsed to its icons, where
                     a header collapses to nothing. -->
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Programs" />

                <!-- Installed apps answers "what does Windows list that is not there", and runs a
                     program's own uninstaller for one that is (§7.3). -->
                <NavigationViewItem x:Name="InstalledAppsItem"
                                    AutomationProperties.HelpText="Remove entries for programs that are gone, or uninstall one">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Startup answers "what put it there at sign-in", beside Memory because a program
                     closed there comes back at the next sign-in if Windows starts it. It stops an
                     entry starting the way Task Manager does, and removes nothing (§7.5). -->
                <NavigationViewItem x:Name="StartupItem"
                                    AutomationProperties.HelpText="Choose what Windows starts when you sign in">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Memory answers "where is the memory going", which §7.2 makes a question of its
                     own. It shows and explains, and has one action on what it shows: asking a
                     program the user picked to close itself (§7.2.1). -->
                <NavigationViewItem x:Name="MemoryItem"
                                    AutomationProperties.HelpText="See where the memory is going">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE964;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Settings and About sit at the foot of the rail: they are where you go once, not
                 part of the task the window exists for. -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem"
                                    AutomationProperties.HelpText="Choose how Deguffer looks, scans and cleans">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutItem"
                                    AutomationProperties.HelpText="See the version, how Deguffer scans and what the safety tiers mean">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid RowDefinitions="Auto,*">
                <!--
                    Above every page, and never closable: while Deguffer runs as an account that is not
                    the one signed in to Windows, the Storage page holds back its rows for one account's
                    files and the Startup and Installed apps pages list that account's own entries, and a
                    reader who closed this would be left with no reason why. Opened by the window only
                    when Core has something to say (RunningAccount.Notice).
                -->
                <InfoBar x:Name="AccountNotice"
                         Grid.Row="0"
                         Margin="{StaticResource PageNoticeMargin}"
                         Severity="Warning"
                         IsClosable="False" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
