<?xml version="1.0" encoding="utf-8"?>
<!--
    The Scan button's drop-down: every location Deguffer recognises under its category, a search to
    narrow them, and a scan of the ones ticked. A control of its own, so the Storage page hands it only
    the choice and the command that scans it, and keeps none of its rows or headings.
-->
<UserControl
    x:Class="Deguffer.App.Views.ScanChoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels">

    <UserControl.Resources>
        <!-- The locations under their category headings, handed their source from code-behind, as
             ItemListView's grouped list is. -->
        <CollectionViewSource x:Key="Groups" IsSourceGrouped="True" />
    </UserControl.Resources>

    <Grid Width="380" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
        <TextBlock Text="Choose what to scan" Style="{StaticResource SectionHeading}" />

        <TextBox Grid.Row="1"
                 PlaceholderText="Search locations"
                 AutomationProperties.Name="Search locations"
                 AutomationProperties.AutomationId="ScanChoiceSearch"
                 Text="{x:Bind Choice.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Grid.Row="2">
            <!-- Virtualizing, with a fixed height to fill: given unbounded height, a list realises
                 every row. -->
            <ListView x:Name="LocationList"
                      Height="360"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      AutomationProperties.Name="Locations to scan">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScanChoiceRow">
                        <!-- The mark sits beside the tick rather than taking it away: a tool installed
                             since that scan is what a fresh scan finds. -->
                        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
                            <CheckBox MinWidth="0"
                                      IsChecked="{x:Bind IsChosen, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                      AutomationProperties.AutomationId="{x:Bind ToggleAutomationId}">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                            </CheckBox>

                            <TextBlock Grid.Column="1"
                                       Text="Not found last scan"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind WasMissing, Mode=OneWay}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="ListViewHeaderItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,8,12,0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </GroupStyle.HeaderContainerStyle>

                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:ScanChoiceGroup">
                                <!-- The heading's tick covers the rows the search shows under it, and a
                                     click on a mixed one clears them. See ItemSelection.ValueForClick. -->
                                <CheckBox MinWidth="0"
                                          IsChecked="{x:Bind State, Mode=OneWay}"
                                          Command="{x:Bind ToggleCommand}"
                                          AutomationProperties.Name="{x:Bind ToggleName}"
                                          AutomationProperties.AutomationId="{x:Bind ToggleAutomationId}">
                                    <!-- Styled here, because a list header's own style sets a heading-sized
                                         font that every text inside it inherits. -->
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </CheckBox>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <TextBlock Text="No location matches the search."
                       Visibility="{x:Bind Choice.HasNoMatches, Mode=OneWay}"
                       Style="{StaticResource SecondaryText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,24,0,0" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="Your choice could not be written to disk, so it has not been applied. Check that %LOCALAPPDATA%\Deguffer is writable."
                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind Choice.SaveFailed, Mode=OneWay}" />

        <Grid Grid.Row="4" ColumnSpacing="12" ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Bind Choice.ChosenSummary, Mode=OneWay}"
                       Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Scan"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ScanCommand}"
                    Click="OnScanClicked"
                    AutomationProperties.Name="Scan the chosen locations"
                    AutomationProperties.AutomationId="ScanChosenButton" />
        </Grid>
    </Grid>
</UserControl>
