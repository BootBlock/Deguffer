<?xml version="1.0" encoding="UTF-8" ?>
<!--
    §5.6's checks, each named: what it is about, what it found, and why it was made. One control for
    every page that acts, so a check reads the same wherever it is listed, and a page that removes
    cannot count its failures without a place to name them.

    Bounded and scrolling, because one run can have a check per project on the disk, and a card that
    grows with it pushes the rest of the page off the screen. A repeater rather than an ItemsControl,
    because it realises only what the bounded viewport shows.
-->
<UserControl
    x:Class="Deguffer.App.Views.VerificationCheckList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:execution="using:Deguffer.Core.Execution">

    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
        <ItemsRepeater ItemsSource="{x:Bind Checks, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="execution:VerificationCheck">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{x:Bind Subject}"
                                   TextWrapping="Wrap"
                                   FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                   FontWeight="SemiBold"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Detail}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryText}"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind Reason}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryText}"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </ScrollViewer>
</UserControl>
