<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The Settings page's scanning section, folded into one expander that starts closed. Every value
    here changes how fast a scan reads the disk, never what it finds: the table is still read whole,
    the walk still never follows a link, and a refused folder is still reported, whatever is set. So
    they are folded away below the settings that decide what may be deleted, and the closed header
    still says what holds, the route and how many values were set, so a tuned scan is never hidden.

    A value is held per kind of drive because one machine often has several kinds. The kind of drive
    heads a card of its own, with the five values it governs indented under it and the drives present
    listed beside them, so a reader can tell those five apply to the kind chosen and to nothing else.
-->
<UserControl
    x:Class="Deguffer.App.Views.ScanSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:text="using:Deguffer.Core.Text"
    xmlns:views="using:Deguffer.App.Views"
    xmlns:viewModels="using:Deguffer.App.ViewModels">

    <Expander x:Name="ScanningExpander"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              AutomationProperties.Name="Scanning"
              AutomationProperties.HelpText="{x:Bind Scanning.Summary, Mode=OneWay}">
        <Expander.Header>
            <!-- The columns a settings row has, so the header reads as the row it folds. -->
            <Grid Padding="{StaticResource ExpanderRowPadding}" ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE9D9;"
                          FontSize="{StaticResource GlyphSizeLarge}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="{StaticResource LabelGap}" VerticalAlignment="Center">
                    <TextBlock Text="Scanning" TextWrapping="Wrap" />
                    <TextBlock Text="How fast a scan reads the disk. None of these changes what a scan finds."
                               Style="{StaticResource Caption}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{x:Bind Scanning.Summary, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Expander.Header>

        <StackPanel Spacing="{StaticResource ControlGap}">
            <views:SettingsRow Glyph="&#xE721;"
                               Title="How to scan"
                               SaveFailed="{x:Bind Scanning.RouteSave.Failed, Mode=OneWay}"
                               Description="Whether a scan walks folders, reads the file table, or both. None of the choices changes what is found."
                               Default="{x:Bind Scanning.Defaults.Route}"
                               Details="Reading a volume's file table needs Deguffer to run as administrator on an NTFS volume. Auto walks folders while it reads the table and uses whichever answers first, and walks everywhere the table cannot be read. Walk folders only is slower on a large folder, and is the choice if you doubt what the file table says. File table first waits for the table instead, which may suit a spinning disk.">
                <views:SettingsRow.Control>
                    <ComboBox x:Name="RouteBox"
                              ItemsSource="{x:Bind Scanning.RouteNames}"
                              SelectedIndex="{x:Bind Scanning.RouteIndex, Mode=TwoWay}"
                              MinWidth="150"
                              ToolTipService.ToolTip="Auto reads the file table and walks folders at the same time, and uses whichever answers first."
                              AutomationProperties.Name="How to scan" />
                </views:SettingsRow.Control>
            </views:SettingsRow>

            <views:SettingsRow Glyph="&#xE950;"
                               Title="File table parse threads"
                               SaveFailed="{x:Bind Scanning.TableParseThreadsSave.Failed, Mode=OneWay}"
                               Description="Threads that turn a file table into folders and sizes, on every kind of drive. Administrator only. Empty the box for Auto."
                               Unit="{x:Bind text:SettingUnit.Threads(Scanning.TableParseThreads, Scanning.AutoTableParseThreadsCount), Mode=OneWay}"
                               Default="{x:Bind Scanning.Defaults.TableParseThreads}">
                <views:SettingsRow.Control>
                    <NumberBox x:Name="TableParseThreadsBox"
                               Value="{x:Bind Scanning.TableParseThreads, Mode=TwoWay}"
                               PlaceholderText="{x:Bind Scanning.AutoTableParseThreads, Mode=OneWay}"
                               Minimum="{x:Bind Scanning.MinimumTableParseThreads}"
                               Maximum="{x:Bind Scanning.MaximumTableParseThreads}"
                               SmallChange="1"
                               LargeChange="4"
                               SpinButtonPlacementMode="Compact"
                               ValidationMode="InvalidInputOverwritten"
                               MinWidth="150"
                               ToolTipService.ToolTip="Auto uses one thread per processor, up to four, which was as fast as more where it was measured."
                               AutomationProperties.Name="File table parse threads" />
                </views:SettingsRow.Control>
            </views:SettingsRow>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="{StaticResource ControlGap}">
                    <views:SettingsRow Glyph="&#xEDA2;"
                                       Title="Kind of drive"
                                       Description="Each kind of drive has its own values, as one that suits one kind can slow another. The values below are for the kind chosen.">
                        <views:SettingsRow.Control>
                            <ComboBox x:Name="KindBox"
                                      ItemsSource="{x:Bind Scanning.KindNames}"
                                      SelectedIndex="{x:Bind Scanning.KindIndex, Mode=TwoWay}"
                                      MinWidth="150"
                                      AutomationProperties.Name="Kind of drive" />
                        </views:SettingsRow.Control>
                    </views:SettingsRow>

                    <!-- Indented under the picker they answer to, so no row reads as a setting for every drive. -->
                    <StackPanel x:Name="KindValues" Spacing="{StaticResource ControlGap}" Margin="{StaticResource NestedRowIndent}">
                        <views:SettingsRow Glyph="&#xE8B7;"
                                           Title="Folders read at once"
                                           SaveFailed="{x:Bind Scanning.WalkThreadsSave.Failed, Mode=OneWay}"
                                           Description="How many folders a walk reads at the same time on this kind of drive. Empty the box to go back to Auto."
                                           Unit="{x:Bind text:SettingUnit.Threads(Scanning.WalkThreads, Scanning.AutoWalkThreadsCount), Mode=OneWay}"
                                           Default="{x:Bind Scanning.Defaults.WalkThreads}">
                            <views:SettingsRow.Control>
                                <NumberBox x:Name="WalkThreadsBox"
                                           Value="{x:Bind Scanning.WalkThreads, Mode=TwoWay}"
                                           PlaceholderText="{x:Bind Scanning.AutoWalkThreads, Mode=OneWay}"
                                           Minimum="{x:Bind Scanning.MinimumWalkThreads}"
                                           Maximum="{x:Bind Scanning.MaximumWalkThreads}"
                                           SmallChange="1"
                                           LargeChange="4"
                                           SpinButtonPlacementMode="Compact"
                                           ValidationMode="InvalidInputOverwritten"
                                           MinWidth="150"
                                           ToolTipService.ToolTip="Auto uses the number measured as fastest for this kind of drive, or the number scans have always used where this kind has not been measured."
                                           AutomationProperties.Name="Folders read at once" />
                            </views:SettingsRow.Control>
                        </views:SettingsRow>

                        <views:SettingsRow Glyph="&#xE8FD;"
                                           Title="Listing buffer"
                                           SaveFailed="{x:Bind Scanning.ListingBufferSave.Failed, Mode=OneWay}"
                                           Description="How much of a folder's listing Windows hands over in each call on this kind of drive. Empty the box for Auto."
                                           Details="A larger buffer means fewer calls, and each call costs the whole buffer however few entries the folder holds."
                                           Default="{x:Bind Scanning.Defaults.ListingBufferKiB}"
                                           Unit="{x:Bind text:SettingUnit.Kilobytes}">
                            <views:SettingsRow.Control>
                                <NumberBox x:Name="ListingBufferBox"
                                           Value="{x:Bind Scanning.ListingBufferKiB, Mode=TwoWay}"
                                           PlaceholderText="{x:Bind Scanning.AutoListingBufferKiB, Mode=OneWay}"
                                           Minimum="{x:Bind Scanning.MinimumListingBufferKiB}"
                                           Maximum="{x:Bind Scanning.MaximumListingBufferKiB}"
                                           SmallChange="4"
                                           LargeChange="64"
                                           SpinButtonPlacementMode="Compact"
                                           ValidationMode="InvalidInputOverwritten"
                                           MinWidth="150"
                                           ToolTipService.ToolTip="Auto uses the size measured as fastest for this kind of drive, or the size scans have always used where this kind has not been measured."
                                           AutomationProperties.Name="Listing buffer in KB" />
                            </views:SettingsRow.Control>
                        </views:SettingsRow>

                        <views:SettingsRow Glyph="&#xE9F5;"
                                           Title="File table read size"
                                           SaveFailed="{x:Bind Scanning.TableReadSave.Failed, Mode=OneWay}"
                                           Description="How much of a volume's file table each read asks for on this kind of drive. Administrator only. Empty the box for Auto."
                                           Default="{x:Bind Scanning.Defaults.TableReadKiB}"
                                           Unit="{x:Bind text:SettingUnit.Kilobytes}">
                            <views:SettingsRow.Control>
                                <NumberBox x:Name="TableReadBox"
                                           Value="{x:Bind Scanning.TableReadKiB, Mode=TwoWay}"
                                           PlaceholderText="{x:Bind Scanning.AutoTableReadKiB, Mode=OneWay}"
                                           Minimum="{x:Bind Scanning.MinimumTableReadKiB}"
                                           Maximum="{x:Bind Scanning.MaximumTableReadKiB}"
                                           SmallChange="64"
                                           LargeChange="1024"
                                           SpinButtonPlacementMode="Compact"
                                           ValidationMode="InvalidInputOverwritten"
                                           MinWidth="150"
                                           ToolTipService.ToolTip="Auto uses the size measured as fastest for this kind of drive, or the size scans have always used where this kind has not been measured."
                                           AutomationProperties.Name="File table read size in KB" />
                            </views:SettingsRow.Control>
                        </views:SettingsRow>

                        <views:SettingsRow Glyph="&#xE9D5;"
                                           Title="File table reads at once"
                                           SaveFailed="{x:Bind Scanning.TableReadsInFlightSave.Failed, Mode=OneWay}"
                                           Description="How many file table reads wait at once on this kind of drive. Administrator only. Empty the box for Auto."
                                           Details="Each read and each parse thread holds a buffer of the read size until the scan ends."
                                           Unit="{x:Bind text:SettingUnit.Reads(Scanning.TableReadsInFlight, Scanning.AutoTableReadsInFlightCount), Mode=OneWay}"
                                           Default="{x:Bind Scanning.Defaults.TableReadsInFlight}">
                            <views:SettingsRow.Control>
                                <NumberBox x:Name="TableReadsInFlightBox"
                                           Value="{x:Bind Scanning.TableReadsInFlight, Mode=TwoWay}"
                                           PlaceholderText="{x:Bind Scanning.AutoTableReadsInFlight, Mode=OneWay}"
                                           Minimum="{x:Bind Scanning.MinimumTableReadsInFlight}"
                                           Maximum="{x:Bind Scanning.MaximumTableReadsInFlight}"
                                           SmallChange="1"
                                           LargeChange="4"
                                           SpinButtonPlacementMode="Compact"
                                           ValidationMode="InvalidInputOverwritten"
                                           MinWidth="150"
                                           ToolTipService.ToolTip="Auto uses the number past which more reads gained little on this kind of drive, or one read at a time where no measurement favoured more."
                                           AutomationProperties.Name="File table reads at once" />
                            </views:SettingsRow.Control>
                        </views:SettingsRow>

                        <views:SettingsRow Glyph="&#xE8FD;"
                                           Title="Attribute list reads at once"
                                           SaveFailed="{x:Bind Scanning.TableListReadsInFlightSave.Failed, Mode=OneWay}"
                                           Description="How many lists kept outside the file table are read at once on this kind of drive. Used only when Deguffer runs as administrator."
                                           Unit="{x:Bind text:SettingUnit.Reads(Scanning.TableListReadsInFlight, Scanning.AutoTableListReadsInFlightCount), Mode=OneWay}"
                                           Default="{x:Bind Scanning.Defaults.TableListReadsInFlight}">
                            <views:SettingsRow.Control>
                                <NumberBox x:Name="TableListReadsInFlightBox"
                                           Value="{x:Bind Scanning.TableListReadsInFlight, Mode=TwoWay}"
                                           PlaceholderText="{x:Bind Scanning.AutoTableListReadsInFlight, Mode=OneWay}"
                                           Minimum="{x:Bind Scanning.MinimumTableListReadsInFlight}"
                                           Maximum="{x:Bind Scanning.MaximumTableListReadsInFlight}"
                                           SmallChange="1"
                                           LargeChange="8"
                                           SpinButtonPlacementMode="Compact"
                                           ValidationMode="InvalidInputOverwritten"
                                           MinWidth="150"
                                           ToolTipService.ToolTip="These lists describe files in many pieces. On an NVMe SSD they are read while the table is, and on other drives after it, where each one waiting adds to the scan. Auto reads 32 at once, which was fastest where it was measured. One at a time took several times as long on the drive measured with thousands of lists. Empty the box to go back to Auto."
                                           AutomationProperties.Name="Attribute list reads at once" />
                            </views:SettingsRow.Control>
                        </views:SettingsRow>

                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Margin="4,8,0,0"
                                   Text="What each drive is scanned with:" />

                        <ItemsRepeater x:Name="DrivesList"
                                       ItemsSource="{x:Bind Scanning.Drives, Mode=OneWay}"
                                       Margin="4,0,0,0"
                                       AutomationProperties.Name="What each drive is scanned with">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DriveLine">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Expander>
</UserControl>
