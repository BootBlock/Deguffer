<?xml version="1.0" encoding="UTF-8" ?>
<!--
    A disclosure stripped back to a line of text and a chevron. In its default form the Expander is
    a filled, bordered box with a 64px header, which made the least important thing on a Storage
    card the loudest thing on the screen. These are the standard Expander theme resources,
    overridden so a disclosure is quiet without restyling the control.

    Each control that draws such a disclosure takes these as its own resources: an Expander looks
    its theme resources up from where it is drawn, and a page's resources do not reach inside a
    control of its own.
-->
<ResourceDictionary
    x:Class="Deguffer.App.Views.QuietDisclosures"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
    <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
    <Thickness x:Key="ExpanderHeaderPadding">0,0,8,0</Thickness>
    <Thickness x:Key="ExpanderContentPadding">0,4,0,4</Thickness>
    <x:Double x:Key="ExpanderMinHeight">32</x:Double>
</ResourceDictionary>
