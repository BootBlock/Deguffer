<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="Deguffer.App.Views.ProviderInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels">

    <UserControl.Resources>
        <!-- §7: nothing is deleted without a preview, so the exact step is inspectable before the user
             confirms. This is the one step of a row that has nothing to choose between; a row whose
             steps are chosen one by one lists them on the Storage page instead. -->
        <DataTemplate x:Key="PlanStep" x:DataType="vm:StepViewModel">
            <!-- Size and age stack in one fixed-width column, so a step with no age costs the
                 description no width for a cell it never fills. -->
            <Grid ColumnSpacing="10"
                  Margin="0,2"
                  ColumnDefinitions="*,80">

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind Description}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               FontSize="13" />

                    <!-- Shown when Deguffer can see the location and cannot remove it as it is
                         running. The reason is the whole of what the user needs in order to act. -->
                    <TextBlock Text="Needs administrator rights — use the Elevate button"
                               Visibility="{x:Bind NeedsElevationFirst}"
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind SizeLabel}"
                               Style="{StaticResource SecondaryText}"
                               TextAlignment="Right"
                               FontSize="12" />

                    <!-- Text, never colour alone (§6.5). No automation name, because one would replace
                         the value a screen reader announces; the text already says "ago". -->
                    <TextBlock Text="{x:Bind AgeLabel}"
                               Visibility="{x:Bind HasAge}"
                               Style="{StaticResource SecondaryText}"
                               TextAlignment="Right"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Two questions, kept apart. "What is this?" is answerable the moment the dialog opens and is
        the same every time; "Contents" is this scan's plan.
    -->
    <Pivot x:Name="Sections">

        <PivotItem Header="What is this?">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,16,0">
                <StackPanel Spacing="18">

                    <StackPanel Spacing="2">
                        <TextBlock Text="Application" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind Finding.Description.Application}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Provenance, stated rather than implied. Somebody deciding whether to let a
                         cleaner near a directory is entitled to know whose directory it is. -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Published by" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind Finding.Description.Publisher}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="What it is for" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind Finding.Description.Purpose}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Should you clean it?" Style="{StaticResource FieldLabel}" />

                        <!-- The verdict is §3's, so it arrives with the tier that produced it.
                             Tier is text on a tinted chip, never colour alone: the classification
                             must survive a flat background and a high-contrast theme (§6.5). -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ContentControl Content="{x:Bind Finding.TierLabel}"
                                            Style="{x:Bind Finding.Tier, Converter={StaticResource TierChipStyle}}"
                                            ToolTipService.ToolTip="{x:Bind Finding.TierExplanation}"
                                            AutomationProperties.Name="{x:Bind Finding.TierLabel}"
                                            AutomationProperties.HelpText="{x:Bind Finding.TierExplanation}" />
                            <TextBlock Text="{x:Bind Finding.CleaningAdvice}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind Finding.Description.Recommendation}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- §7's own sentence, repeated here rather than moved here. It stays on the
                         row, because §7 requires it to be reachable from the row by whatever the
                         reader is using, and a dialog is not that. -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="What it costs you" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{x:Bind Finding.WhatHappensOnNextUse}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <PivotItem x:Name="ContentsSection" Header="Contents">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,16,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Finding.Text.DetailHeader}"
                               Style="{StaticResource FieldLabel}" />

                    <!-- A row whose toolchain is absent has no plan at all, so this tab would
                         otherwise be a blank panel behind a tab that promised a list. -->
                    <TextBlock Visibility="{x:Bind Finding.HasNoDetail}"
                               Style="{StaticResource SecondaryText}"
                               Text="There is nothing here for Deguffer to remove." />

                    <!-- A row whose steps are chosen one by one lists them on the Storage page, where
                         the list can be searched, the Selected total is on screen, and a thousand
                         items cost only the ones in view. This says where they are and goes there. -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Finding.OffersItems}">
                        <TextBlock Text="{x:Bind Finding.Text.ItemsSentence}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <Button Content="Show the items"
                                Click="OnShowItemsClicked"
                                AutomationProperties.Name="{x:Bind Finding.Text.ItemsLinkName}" />
                    </StackPanel>

                    <ContentControl Content="{x:Bind Finding.SoleStep}"
                                    ContentTemplate="{StaticResource PlanStep}"
                                    Visibility="{x:Bind Finding.HasSoleStep}"
                                    HorizontalContentAlignment="Stretch"
                                    IsTabStop="False" />

                    <!-- Bound rather than copied, because keeping or releasing an item changes the
                         notes, and a copy refreshed from an event goes stale whenever the dialog's
                         content is unloaded and reloaded around that event. -->
                    <ItemsControl ItemsSource="{x:Bind Finding.Notes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           Style="{StaticResource SecondaryText}"
                                           FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</UserControl>
