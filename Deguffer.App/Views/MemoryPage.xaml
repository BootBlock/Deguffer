<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:execution="using:Deguffer.Core.Execution"
    xmlns:vm="using:Deguffer.App.ViewModels"
    Background="Transparent">

    <Grid Padding="20,12,20,16" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

        <!--
            The headline. §7.2 leads with commit charge against the commit limit, because that is the
            figure that states the failure a user feels: allocations fail when it reaches the limit.
            Available memory sits beside it rather than above it, because low available memory is
            Windows working as designed and leading with it would present a cache as a problem.
        -->
        <Grid Grid.Row="0" ColumnSpacing="20" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Commit, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" />

                <!-- The bar states the same figure as the words above it, so it is not the only
                     place the figure is readable, and it carries no colour of its own. -->
                <ProgressBar Maximum="100"
                             Height="4"
                             Value="{x:Bind ViewModel.Committed, Mode=OneWay}"
                             AutomationProperties.AccessibilityView="Raw" />

                <TextBlock Text="Committed memory against the commit limit. Allocations start to fail as it reaches the limit."
                           TextWrapping="Wrap"
                           Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.Available, Mode=OneWay}"
                       VerticalAlignment="Top"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <!-- Indexed against ExploreView, so the order here is that enum's order. There is no
                 colour picker: a memory picture has no dates to band, so its colours say which part
                 a shape belongs to and nothing else. -->
            <ComboBox x:Name="ViewSelector"
                      Grid.Column="2"
                      MinWidth="120"
                      Header="View"
                      SelectionChanged="OnViewSelectionChanged"
                      AutomationProperties.Name="How to draw where memory is">
                <ComboBoxItem Content="Treemap" />
                <ComboBoxItem Content="Icicle" />
                <ComboBoxItem Content="Sunburst" />
                <ComboBoxItem Content="List" />
                <ComboBoxItem Content="Tree" />
            </ComboBox>
        </Grid>

        <!-- Where you are, and the way back out. -->
        <Grid Grid.Row="1" ColumnSpacing="8" ColumnDefinitions="Auto,*"
              Visibility="{x:Bind ViewModel.HasTree, Mode=OneWay}">
            <Button Grid.Column="0"
                    Padding="8,4"
                    Click="OnAscend"
                    IsEnabled="{x:Bind ViewModel.CanAscend, Mode=OneWay}"
                    ToolTipService.ToolTip="Go up one level"
                    AutomationProperties.Name="Go up one level">
                <FontIcon Glyph="&#xE74A;" FontSize="12" />
            </Button>

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Trail}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCrumb">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- The separator between two steps, so the trail reads as a path down
                                 into something rather than as a row of links. Raw to a screen
                                 reader, which is given the steps themselves and their order. -->
                            <FontIcon Glyph="&#xE76C;"
                                      FontSize="10"
                                      Margin="2,0,2,0"
                                      Visibility="{x:Bind FollowsAnother, Mode=OneWay}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />

                            <!-- The crumb itself carries which node it means, because the tree
                                 renumbers its nodes on every reading and a number bound here would
                                 not. -->
                            <HyperlinkButton Content="{x:Bind Name, Mode=OneWay}"
                                             Padding="4,2"
                                             Click="OnCrumbClicked" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- What this read could not measure, and that every figure is a lower bound (§7.2). Above
             the picture rather than over it: they change only when the machine's answers change, so
             they never resize the card while it is being read. -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.Notes}"
                      AutomationProperties.Name="What these figures are, and what this reading could not measure">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <!--
                    The picture. Its own name and help text, rather than the map's defaults, which
                    name Explore's picker and call the drawing a scan.
                -->
                <controls:ExploreMap x:Name="Map"
                                     AutomationProperties.Name="Map of where memory is"
                                     AutomationProperties.HelpText="A picture of where physical memory is. Choose List in the View box for the same contents as a readable list.">
                    <!--
                        What the thing under the pointer is, and why the size it is drawn at is
                        normal (§7.2). A floating tooltip, where the readout below deliberately is
                        not, and the difference is what each costs when it changes. The readout is
                        one line that never wraps, so a new name cannot move anything. This is
                        several sentences of wrapped text, and under the picture it reflowed the page
                        on every shape the pointer crossed: the picture lost a line, the shape under
                        the pointer moved out from under it, and the reader was left chasing it.

                        A reader who cannot use the picture gets the same sentence on the row, where
                        the list carries it as help text as well as a tooltip.
                    -->
                    <ToolTipService.ToolTip>
                        <ToolTip MaxWidth="420"
                                 Content="{x:Bind ViewModel.HoveredNote, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasHoveredNote, Mode=OneWay}">
                            <ToolTip.ContentTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ToolTip.ContentTemplate>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                </controls:ExploreMap>

                <!--
                    The same contents as a list, for a reader who cannot use a picture. One row at a
                    time is selectable, because §7.2.1's one action is about one program the user
                    picked out by hand. A double click opens what holds other things, as Explore's
                    list does, because a single click now means "I pick this one".
                -->
                <ListView x:Name="RowsList"
                          AutomationProperties.Name="Where memory is, as a list"
                          Visibility="Collapsed"
                          SelectionMode="Single"
                          SelectionChanged="OnRowSelectionChanged"
                          DoubleTapped="OnRowsDoubleTapped"
                          ItemsSource="{x:Bind ViewModel.Rows}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemoryRow">
                            <!-- The figures column is wide enough for both of them on one line: a
                                 process states what it holds in memory and what it has committed,
                                 and wrapped across two lines they read as two rows. -->
                            <Grid ColumnSpacing="12" Padding="0,4"
                                  Background="Transparent"
                                  ColumnDefinitions="*,120,280,36"
                                  AutomationProperties.Name="{x:Bind Description, Mode=OneWay}"
                                  AutomationProperties.HelpText="{x:Bind Explanation, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="420" Content="{x:Bind Explanation, Mode=OneWay}">
                                        <ToolTip.ContentTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ToolTip.ContentTemplate>
                                    </ToolTip>
                                </ToolTipService.ToolTip>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- Scaled against what holds this row, so it answers "how much of
                                     this part is that". -->
                                <ProgressBar Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Maximum="100"
                                             Value="{x:Bind Share, Mode=OneWay}"
                                             AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Held, Mode=OneWay}"
                                           TextAlignment="Right"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryText}" />

                                <!-- Which rows open into something, and the way in. Nesting is
                                     plain on the picture and invisible in a list, so the list says
                                     it — and a chevron that says a row opens and cannot be pressed
                                     is the affordance without the action, so it is a button. It
                                     names the row it opens rather than saying "this", because a
                                     screen reader reads it on its own.

                                     Pressing it opens the row and does not pick it: the button
                                     takes the press, so the list reports no selection for it, and a
                                     single click on the row itself still means "I pick this one". -->
                                <Button Grid.Column="3"
                                        Width="32"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind HasChildren, Mode=OneWay}"
                                        Click="OnOpenRow"
                                        ToolTipService.ToolTip="{x:Bind Opens, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Opens, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    The same contents again, as a tree that opens where it sits. The list is a route:
                    going inside a process replaces the rows with what it held, and a reader
                    following a process tree down four levels has the rest of the machine off screen
                    by the second. The tree answers the same question without leaving: what holds a
                    thing stays above it, and its neighbours stay beside it.

                    One row at a time is selectable here too, and §7.2.1's one action is the same
                    action on the same selection, so a reader who prefers the tree is not sent back
                    to the list to use it.
                -->
                <TreeView x:Name="TreeList"
                          Visibility="Collapsed"
                          SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.Rows}"
                          Expanding="OnRowExpanding"
                          Collapsed="OnRowCollapsed"
                          SelectionChanged="OnTreeSelectionChanged"
                          AutomationProperties.Name="Where memory is, as a tree"
                          AutomationProperties.HelpText="A tree of where physical memory is. Open a row to see what it holds without leaving what holds it.">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemoryRow">
                            <!-- The rows under a row, which the view model fills in for as far as
                                 the reader has opened. A row whose contents have not been filled in
                                 carries no expander, so they are filled one level ahead of what is
                                 on screen. -->
                            <TreeViewItem ItemsSource="{x:Bind Children}"
                                          AutomationProperties.Name="{x:Bind Description, Mode=OneWay}"
                                          AutomationProperties.HelpText="{x:Bind Explanation, Mode=OneWay}">
                                <Grid ColumnSpacing="12"
                                      Background="Transparent"
                                      ColumnDefinitions="*,120,280">
                                    <ToolTipService.ToolTip>
                                        <ToolTip MaxWidth="420" Content="{x:Bind Explanation, Mode=OneWay}">
                                            <ToolTip.ContentTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ToolTip.ContentTemplate>
                                        </ToolTip>
                                    </ToolTipService.ToolTip>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Name, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Scaled against what holds this row, as the list's is. -->
                                    <ProgressBar Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 Maximum="100"
                                                 Value="{x:Bind Share, Mode=OneWay}"
                                                 AutomationProperties.AccessibilityView="Raw" />

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Held, Mode=OneWay}"
                                               TextAlignment="Right"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Before the first reading arrives, and where one failed outright. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                            Visibility="{x:Bind ViewModel.HasNoTree, Mode=OneWay}">
                    <TextBlock Text="Reading where memory is"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Nothing is changed by looking. Deguffer asks a program to close only when you pick it and say so."
                               HorizontalAlignment="Center"
                               Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Spacing="6">
            <!-- What the pointer is over: what it is called, and what it holds. Both are one line
                 that never wraps, so naming a new shape cannot change the height of anything above
                 it. What the thing under the pointer *is* wraps, so it is the tooltip on the
                 picture instead. -->
            <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto">
                <!-- Holds the line open while nothing is under the pointer. See LineStrut. -->
                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource LineStrut}" />
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.Hovered, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.HoveredFigures, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="NoWrap" />
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.Failure, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!--
            What the user picked, and §7.2.1's one action on it. The button offers the program's own
            close and nothing stronger: there is no terminate here, at any tier, under any preference.

            The button is not disabled on a refusal. §7.2.1 keeps §7.1's rule for a subject that is
            not a path — a refusal is a sentence, never a greyed-out control — and its refusal table
            gives a reader no way to guess which of its rows applied. The button stands down only
            while a close is being watched, which is the action being in progress rather than a
            verdict about anything.
        -->
        <Grid Grid.Row="5"
              ColumnSpacing="12"
              RowSpacing="4"
              ColumnDefinitions="*,Auto,Auto"
              RowDefinitions="Auto,Auto"
              Visibility="{x:Bind ViewModel.Selection.HasSelection, Mode=OneWay}">

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Bind ViewModel.Selection.Label, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       IsTextSelectionEnabled="True" />

            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{x:Bind ViewModel.Selection.Figures, Mode=OneWay}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       Style="{StaticResource SecondaryText}" />

            <Button Grid.Row="0" Grid.Column="2"
                    Grid.RowSpan="2"
                    VerticalAlignment="Top"
                    Content="Ask to close"
                    Command="{x:Bind ViewModel.Selection.CloseCommand}"
                    AutomationProperties.Name="Ask the selected program to close itself" />

            <!-- What Deguffer will do about it, or why it will not. Stated before anything is
                 pressed, and read out as it changes. -->
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{x:Bind ViewModel.Selection.Note, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.Selection.HasNote, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Style="{StaticResource SecondaryText}"
                       IsTextSelectionEnabled="True"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <!--
            The close's report, on a surface of its own (§7.2.1). It cannot go on the status line
            above: the page takes a reading every couple of seconds and clears its reading notes each
            time, so a report there would be wiped inside one cadence. §5.6 exists to leave the user
            evidence, and evidence that disappears before it is read is not evidence.

            It stands until the user takes it down, and taking it down ends the watch, which is one of
            §7.2.1's three ends.
        -->
        <Border Grid.Row="6"
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{x:Bind ViewModel.Selection.Report.HasReport, Mode=OneWay}"
                AutomationProperties.Name="What the close did">

            <Grid ColumnSpacing="12" RowSpacing="8" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{x:Bind ViewModel.Selection.Report.Statement, Mode=OneWay}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.LiveSetting="Assertive"
                           Style="{x:Bind ViewModel.Selection.Report.Failed, Mode=OneWay, Converter={StaticResource RunStatementStyle}}" />

                <Button Grid.Row="0" Grid.Column="1"
                        VerticalAlignment="Top"
                        Content="Dismiss"
                        Command="{x:Bind ViewModel.Selection.Report.DismissCommand}"
                        AutomationProperties.Name="Dismiss this report and stop watching" />

                <!-- Commit charge and available memory, before the close and as the program exited.
                     A report still watching shows only the before figure, because a difference taken
                     against nothing means nothing yet. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{x:Bind ViewModel.Selection.Report.Figures, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.Selection.Report.HasFigures, Mode=OneWay}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Style="{StaticResource SecondaryText}" />

                <!-- §5.6's four kinds of line, each saying which it is: what was sent and where,
                     what this close could not have ended and was looked for again, what was expected
                     to exit with the program, and what exited that Deguffer sent nothing to.

                     Bounded and scrolling for the reason the Storage card's list is: a close on a
                     busy machine reports a line per process that exited while it watched, and a card
                     that grows with it pushes the picture off the screen. -->
                <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              MaxHeight="180"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.Selection.Report.HasChecks, Mode=OneWay}"
                              AutomationProperties.Name="What this close sent, and what it could and could not account for">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Selection.Report.Checks, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="execution:VerificationCheck">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{x:Bind Subject}"
                                               TextWrapping="Wrap"
                                               FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                               FontWeight="SemiBold"
                                               IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Detail}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryText}"
                                               IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Reason}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryText}"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
