<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:vm="using:Deguffer.App.ViewModels"
    Background="Transparent">

    <Grid Padding="20,12,20,16" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!--
            The headline. §7.2 leads with commit charge against the commit limit, because that is the
            figure that states the failure a user feels: allocations fail when it reaches the limit.
            Available memory sits beside it rather than above it, because low available memory is
            Windows working as designed and leading with it would present a cache as a problem.
        -->
        <Grid Grid.Row="0" ColumnSpacing="20" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Commit, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}" />

                <!-- The bar states the same figure as the words above it, so it is not the only
                     place the figure is readable, and it carries no colour of its own. -->
                <ProgressBar Maximum="100"
                             Height="4"
                             Value="{x:Bind ViewModel.Committed, Mode=OneWay}"
                             AutomationProperties.AccessibilityView="Raw" />

                <TextBlock Text="Committed memory against the commit limit. Allocations start to fail as it reaches the limit."
                           TextWrapping="Wrap"
                           Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.Available, Mode=OneWay}"
                       VerticalAlignment="Top"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <!-- Indexed against ExploreView, so the order here is that enum's order. There is no
                 colour picker: a memory picture has no dates to band, so its colours say which part
                 a shape belongs to and nothing else. -->
            <ComboBox x:Name="ViewSelector"
                      Grid.Column="2"
                      MinWidth="120"
                      Header="View"
                      SelectionChanged="OnViewSelectionChanged"
                      AutomationProperties.Name="How to draw where memory is">
                <ComboBoxItem Content="Treemap" />
                <ComboBoxItem Content="Icicle" />
                <ComboBoxItem Content="Sunburst" />
                <ComboBoxItem Content="List" />
            </ComboBox>
        </Grid>

        <!-- Where you are, and the way back out. -->
        <Grid Grid.Row="1" ColumnSpacing="8" ColumnDefinitions="Auto,*"
              Visibility="{x:Bind ViewModel.HasTree, Mode=OneWay}">
            <Button Grid.Column="0"
                    Padding="8,4"
                    Click="OnAscend"
                    IsEnabled="{x:Bind ViewModel.CanAscend, Mode=OneWay}"
                    ToolTipService.ToolTip="Go up one level"
                    AutomationProperties.Name="Go up one level">
                <FontIcon Glyph="&#xE74A;" FontSize="12" />
            </Button>

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Trail}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCrumb">
                        <HyperlinkButton Content="{x:Bind Name}"
                                         Padding="4,2"
                                         Tag="{x:Bind Node}"
                                         Click="OnCrumbClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- What this read could not measure, and that every figure is a lower bound (§7.2). Above
             the picture rather than over it: they change only when the machine's answers change, so
             they never resize the card while it is being read. -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.Notes}"
                      AutomationProperties.Name="What this reading could not measure">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <!--
                    The picture. Its own name and help text, rather than the map's defaults, which
                    name Explore's picker and call the drawing a scan.
                -->
                <controls:ExploreMap x:Name="Map"
                                     AutomationProperties.Name="Map of where memory is"
                                     AutomationProperties.HelpText="A picture of where physical memory is. Choose List in the View box for the same contents as a readable list." />

                <!--
                    The same contents as a list, for a reader who cannot use a picture. Nothing here
                    is selectable: this page acts on nothing, so a selection would offer something
                    that does not exist. A click opens what holds other things.
                -->
                <ListView x:Name="RowsList"
                          Visibility="Collapsed"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnRowClicked"
                          ItemsSource="{x:Bind ViewModel.Rows}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemoryRow">
                            <Grid ColumnSpacing="12" Padding="0,4"
                                  Background="Transparent"
                                  ColumnDefinitions="*,120,190"
                                  AutomationProperties.Name="{x:Bind Description, Mode=OneWay}"
                                  AutomationProperties.HelpText="{x:Bind Explanation, Mode=OneWay}">
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="420" Content="{x:Bind Explanation, Mode=OneWay}">
                                        <ToolTip.ContentTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ToolTip.ContentTemplate>
                                    </ToolTip>
                                </ToolTipService.ToolTip>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- Scaled against what holds this row, so it answers "how much of
                                     this part is that". -->
                                <ProgressBar Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Maximum="100"
                                             Value="{x:Bind Share, Mode=OneWay}"
                                             AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Held, Mode=OneWay}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Before the first reading arrives, and where one failed outright. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                            Visibility="{x:Bind ViewModel.HasNoTree, Mode=OneWay}">
                    <TextBlock Text="Reading where memory is"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Nothing is changed by looking. This page closes and stops nothing."
                               HorizontalAlignment="Center"
                               Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Spacing="6">
            <!-- What the pointer is over. A status line rather than a floating tooltip, for the
                 reason Explore's is: over hundreds of shapes a popup that follows the pointer never
                 settles. -->
            <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto" MinHeight="20">
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.Hovered, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.HoveredFigures, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="NoWrap" />
            </Grid>

            <!-- What the thing under the pointer is. It says what a part holds and why it is normal,
                 and never that anything is safe to close (§7.2). -->
            <TextBlock Text="{x:Bind ViewModel.HoveredNote, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasHoveredNote, Mode=OneWay}"
                       TextWrapping="Wrap"
                       MinHeight="18"
                       Style="{StaticResource SecondaryText}" />

            <TextBlock Text="{x:Bind ViewModel.Failure, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasFailure, Mode=OneWay}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Page>
