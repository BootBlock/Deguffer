<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Deguffer.App.Views.MapColoursSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels"
    xmlns:views="using:Deguffer.App.Views">

    <!-- The palette first, then how strong and how light every colour of it is drawn, then what the
         folders round what they hold are filled with. Every box is indexed against the enum it sets,
         in the enum's order. -->
    <StackPanel Spacing="8">

        <!-- Which picture the list below changes. One list serves all three, so the heading is what
             tells the reader that choosing here leaves the other two as they were. -->
        <TextBlock Text="{x:Bind ViewModel.SchemeHeading, Mode=OneWay}"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <ListView SelectionMode="Single"
                  ItemsSource="{x:Bind ViewModel.Schemes}"
                  SelectedIndex="{x:Bind ViewModel.SchemeIndex, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.SchemeHeading, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MapSchemeOption">
                    <StackPanel Padding="0,8" Spacing="4" AutomationProperties.Name="{x:Bind Spoken}">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryText}" />

                        <!-- Two strips: a few folders as a treemap draws its largest, and the age
                             bands newest first. Raw to a screen reader, which is given the
                             description above instead. -->
                        <ItemsControl ItemsSource="{x:Bind Branches}"
                                      Margin="0,4,0,0"
                                      AutomationProperties.AccessibilityView="Raw">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MapSwatch">
                                    <Border Width="36" Height="14" CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{x:Bind Colour}" />
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{x:Bind Ages}"
                                      AutomationProperties.AccessibilityView="Raw">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MapSwatch">
                                    <Border Width="30" Height="8" CornerRadius="{ThemeResource ControlCornerRadius}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{x:Bind Colour}" />
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="Every picture"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,12,0,0" />

        <!-- Never the grey of a block such as free space, whose colour says what it is. -->
        <views:SettingsRow Glyph="&#xE7A1;"
                           Title="Colour strength"
                           Description="How much colour each shape keeps, from none, which draws the map in greys, to more than the palette's own.">
            <views:SettingsRow.Control>
                <ComboBox MinWidth="168"
                          SelectedIndex="{x:Bind ViewModel.SaturationIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Colour strength">
                    <ComboBoxItem Content="Grey" />
                    <ComboBoxItem Content="Muted" />
                    <ComboBoxItem Content="Soft" />
                    <ComboBoxItem Content="Standard" />
                    <ComboBoxItem Content="Vivid" />
                </ComboBox>
            </views:SettingsRow.Control>
        </views:SettingsRow>

        <views:SettingsRow Glyph="&#xE706;"
                           Title="Brightness"
                           Description="How far each shape's colour is lightened or darkened from the palette's own.">
            <views:SettingsRow.Control>
                <ComboBox MinWidth="168"
                          SelectedIndex="{x:Bind ViewModel.BrightnessIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Brightness of the colours">
                    <ComboBoxItem Content="Much darker" />
                    <ComboBoxItem Content="Darker" />
                    <ComboBoxItem Content="Standard" />
                    <ComboBoxItem Content="Lighter" />
                    <ComboBoxItem Content="Much lighter" />
                </ComboBox>
            </views:SettingsRow.Control>
        </views:SettingsRow>

        <views:SettingsRow Glyph="&#xE8B7;"
                           Title="Folders drawn round what they hold"
                           Description="The band along a treemap folder's top and the gap round what it holds.">
            <views:SettingsRow.Control>
                <ComboBox MinWidth="168"
                          SelectedIndex="{x:Bind ViewModel.FolderFillIndex, Mode=TwoWay}"
                          AutomationProperties.Name="Folders drawn round what they hold">
                    <ComboBoxItem Content="In their own colour" />
                    <ComboBoxItem Content="In dark grey" />
                    <ComboBoxItem Content="Tinted towards grey" />
                </ComboBox>
            </views:SettingsRow.Control>
        </views:SettingsRow>
    </StackPanel>
</UserControl>
