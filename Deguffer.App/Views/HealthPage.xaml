<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels"
    xmlns:health="using:Deguffer.Core.Health"
    Background="Transparent">

    <Page.Resources>
        <!-- A drive, with its verdict in a word and its temperature. -->
        <DataTemplate x:Key="DriveTemplate" x:DataType="vm:HealthDriveRow">
            <Grid Padding="0,8" ColumnSpacing="8" RowSpacing="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                  AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                  AutomationProperties.HelpText="{x:Bind Summary, Mode=OneWay}">
                <TextBlock Grid.ColumnSpan="2" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <ContentControl Grid.Row="1" HorizontalAlignment="Left" Content="{x:Bind VerdictText, Mode=OneWay}"
                                Style="{x:Bind Verdict, Mode=OneWay, Converter={StaticResource DriveVerdictChipStyle}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Temperature, Mode=OneWay}"
                           VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
            </Grid>
        </DataTemplate>

        <!-- One reading: its name and value, what it means, its standing in a word, and the numbers
             as the drive holds them. -->
        <DataTemplate x:Key="AttributeTemplate" x:DataType="health:HealthAttribute">
            <Grid Padding="0,8" ColumnSpacing="12" RowSpacing="2" ColumnDefinitions="*,200,Auto" RowDefinitions="Auto,Auto,Auto"
                  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  AutomationProperties.Name="{x:Bind Name}"
                  AutomationProperties.HelpText="{x:Bind Meaning}">
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind Reading}" TextWrapping="Wrap" />
                <ContentControl Grid.Column="2" Content="{x:Bind Standing}"
                                Style="{x:Bind Standing, Converter={StaticResource AttributeStandingChipStyle}}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind Meaning}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{x:Bind Raw}" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryText}" IsTextSelectionEnabled="True" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FactTemplate" x:DataType="health:DriveFact">
            <StackPanel Spacing="1">
                <TextBlock Text="{x:Bind Label}" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{x:Bind Value}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{x:Bind Value}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="DriveContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,12,20,16" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*">

        <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto,Auto,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Health" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsReading, Mode=OneWay}"
                          Width="20" Height="20" VerticalAlignment="Center" />

            <Button Grid.Column="2" Content="Reopen as administrator" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.CanElevate, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ElevateCommand}"
                    ToolTipService.ToolTip="A SATA drive's failure limits, link speed and self-test history can be read only with administrator rights." />

            <Button Grid.Column="3" Content="Refresh" VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    ToolTipService.ToolTip="Read every drive again. This can wake a sleeping disk." />
        </Grid>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                   Text="What each drive reports about its own condition, in plain words. Deguffer only reads this and changes nothing on the drive. Drives can fail without any warning, so keep backups whatever this page says." />

        <!-- Not closable: closing it would hide the only reason the button is there, and a read of
             the drives would have no way to bring it back. -->
        <InfoBar Grid.Row="2" Severity="Informational" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.CanElevate, Mode=OneWay}"
                 Title="More is shown when Deguffer runs as administrator"
                 Message="For SATA drives, that adds failure limits, link speed, self-test history and the drive's error log." />

        <Grid Grid.Row="3" ColumnSpacing="16" ColumnDefinitions="260,*">
            <ListView x:Name="DriveList"
                      AutomationProperties.Name="Drives"
                      SelectionMode="Single"
                      SelectionChanged="OnDriveSelectionChanged"
                      ItemsSource="{x:Bind ViewModel.Rows}"
                      ItemTemplate="{StaticResource DriveTemplate}"
                      ItemContainerStyle="{StaticResource DriveContainer}" />

            <!-- A star row for the attributes, so the list is given a height and stays virtual. -->
            <Grid Grid.Column="1" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*">
                <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.SelectedDrive.Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedDrive.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedDrive.Volumes, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource SecondaryText}" />
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedDrive.Findings, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.SelectedDrive.HasFindings, Mode=OneWay, FallbackValue=Collapsed}"
                              AutomationProperties.Name="What needs attention">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsRepeater Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedDrive.Facts, Mode=OneWay}"
                               ItemTemplate="{StaticResource FactTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill" MinItemWidth="200" MinItemHeight="44"
                                           MinColumnSpacing="16" MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <ListView Grid.Row="3" SelectionMode="None"
                          AutomationProperties.Name="Readings from this drive"
                          ItemsSource="{x:Bind ViewModel.SelectedDrive.Attributes, Mode=OneWay}"
                          ItemTemplate="{StaticResource AttributeTemplate}"
                          ItemContainerStyle="{StaticResource DriveContainer}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
