<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:vm="using:Deguffer.App.ViewModels"
    Background="Transparent">

    <Grid Padding="20,12,20,16" RowSpacing="10"
          RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!--
            The two pickers the issue asks for, and the actions, on one line. The drive sits at the
            left where the reading starts, and the view sits at the right beside the picture it
            governs — a control that changes how something is drawn belongs next to the drawing,
            not next to the thing that produced the data.
        -->
        <Grid Grid.Row="0" ColumnSpacing="8" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
            <ComboBox Grid.Column="0"
                      MinWidth="88"
                      Header="Drive"
                      ItemsSource="{x:Bind ViewModel.Drives}"
                      SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}"
                      AutomationProperties.Name="Drive to scan" />

            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Scan"
                    Command="{x:Bind ViewModel.ScanCommand}" />

            <Button Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Content="Cancel"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ScanCancelCommand}" />

            <!-- §5.5's fallback made actionable, on the same terms the Storage page offers it:
                 shown only where a scan actually fell back for want of rights. -->
            <Button Grid.Column="4"
                    VerticalAlignment="Bottom"
                    Content="Elevate and rescan"
                    Visibility="{x:Bind ViewModel.CanElevate, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ElevateAndRescanCommand}" />

            <!-- These are indexed against ExploreView, so the order here is the order of that
                 enum. The three pictures come before the list because that is the order they are
                 read in, not because the numbers demand it. -->
            <ComboBox x:Name="ViewSelector"
                      Grid.Column="5"
                      MinWidth="120"
                      Header="View"
                      SelectionChanged="OnViewSelectionChanged"
                      AutomationProperties.Name="How to draw the drive">
                <ComboBoxItem Content="Treemap" />
                <ComboBoxItem Content="Icicle" />
                <ComboBoxItem Content="Sunburst" />
                <ComboBoxItem Content="List" />
            </ComboBox>

            <!-- Beside the View box because the two are one decision to the reader — what is on
                 screen and what its colours mean — and orthogonal to it in fact: every pairing of
                 the two is meaningful. Indexed against ExploreColouring, like the box above it. -->
            <ComboBox x:Name="ColourSelector"
                      Grid.Column="6"
                      MinWidth="110"
                      Header="Colour"
                      SelectionChanged="OnColourSelectionChanged"
                      AutomationProperties.Name="What the colours on the map say">
                <ComboBoxItem Content="Branch" />
                <ComboBoxItem Content="Age" />
            </ComboBox>
        </Grid>

        <!--
            Determinate where the route knows its own denominator and indeterminate where it does
            not. A walk cannot count the directories it has not opened yet, and a bar that invents
            a total runs to nine tenths and stops there for a minute.
        -->
        <ProgressBar Grid.Row="1"
                     Height="3"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                     IsIndeterminate="{x:Bind ViewModel.HasNoProgressFraction, Mode=OneWay}"
                     Maximum="1"
                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />

        <!--
            Where you are, and the way back out. A breadcrumb rather than a path in a label: every
            tool in this category lets you climb back by clicking a step, and a label does not.
        -->
        <Grid Grid.Row="2" ColumnSpacing="8" ColumnDefinitions="Auto,*"
              Visibility="{x:Bind ViewModel.HasTree, Mode=OneWay}">
            <Button Grid.Column="0"
                    Padding="8,4"
                    Command="{x:Bind ViewModel.AscendCommand}"
                    ToolTipService.ToolTip="Go up one level"
                    AutomationProperties.Name="Go up one level">
                <FontIcon Glyph="&#xE74A;" FontSize="12" />
            </Button>

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Trail}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExploreCrumb">
                        <HyperlinkButton Content="{x:Bind Name}"
                                         Padding="4,2"
                                         Tag="{x:Bind Node}"
                                         Click="OnCrumbClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--
            The map and the list are the same data, so exactly one is on screen at a time and both
            are bound to the same current node. Kept as two controls rather than one that switches
            its own template: a list is a list, and rebuilding a bitmap through a ListView's item
            machinery would be the wrong shape for both.
        -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <controls:ExploreMap x:Name="Map" />

                <ListView x:Name="RowsList"
                          Visibility="Collapsed"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnRowClicked"
                          ItemsSource="{x:Bind ViewModel.Rows}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExploreRow">
                            <!-- Transparent rather than unset, so the whole row carries the
                                 tooltip. A panel with no background is not hit-tested, so the
                                 gaps between the columns fall through and the exact dates are
                                 reachable only by landing on a word — which is precisely where a
                                 reader is not pointing when they are reading the age column. -->
                            <Grid ColumnSpacing="12" Padding="0,4"
                                  Background="Transparent"
                                  ColumnDefinitions="16,*,120,90,150"
                                  AutomationProperties.Name="{x:Bind Description}"
                                  ToolTipService.ToolTip="{x:Bind DatesLabel}">
                                <FontIcon Grid.Column="0"
                                          FontSize="14"
                                          Glyph="{x:Bind Icon}"
                                          AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- The bar is scaled against the containing folder, so the row
                                     answers "how much of this folder is that" rather than "how does
                                     it compare with the biggest thing here". -->
                                <ProgressBar Grid.Column="2"
                                             VerticalAlignment="Center"
                                             Maximum="100"
                                             Value="{x:Bind Share}"
                                             AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind SizeLabel}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryText}" />

                                <!-- The newest write at or below the row, not the row's own
                                     timestamp — a folder's own date moves when its layout changes
                                     and stands still while its contents are rewritten. The exact
                                     dates, and which is which, are on the row's tooltip. -->
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind AgeLabel}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The empty state. A large blank card reads as a screen that has failed rather
                     than one waiting to be told to start. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                            Visibility="{x:Bind ViewModel.HasNoTree, Mode=OneWay}">
                    <TextBlock Text="Nothing scanned yet"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Choose a drive and press Scan. Nothing is changed by looking."
                               HorizontalAlignment="Center"
                               Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Spacing="6">
            <!-- What the pointer is over. A status line rather than a floating tooltip: over tens
                 of thousands of rectangles a popup that follows the pointer never settles. -->
            <TextBlock Text="{x:Bind ViewModel.Hovered, Mode=OneWay}"
                       Style="{StaticResource SecondaryText}"
                       TextTrimming="CharacterEllipsis"
                       MinHeight="20" />

            <!-- What the colours mean, when they mean an age. A hue per branch needs no legend,
                 because the branch it names is the shape it is inside; an age band means nothing
                 at all without the scale beside it. -->
            <!-- One row that scrolls rather than a wrapping one. ItemsWrapGrid gives every cell
                 the width of the first, so "Today" sized the whole legend and clipped every band
                 after it; the panels that size each item to its own content are not in the
                 framework. A narrow window scrolls this instead, which is what the rest of the app
                 does with content too wide for its container. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          Visibility="{x:Bind ViewModel.ShowsAgeLegend, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.AgeLegend}"
                          AutomationProperties.Name="What the map's colours mean">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExploreLegendBand">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                                    AutomationProperties.Name="{x:Bind Label}">
                            <Border Width="12" Height="12" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind Swatch}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind Label}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />

            <!-- Where what is on screen is not what the View box names. A scan in progress is
                 ordered by name so that it stays still, and a treemap cannot be drawn from that at
                 all — so the map substitutes the icicle. A substitution nobody is told about is
                 the kind a user reads as a bug. -->
            <TextBlock Text="{x:Bind ViewModel.ViewNote, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.HasViewNote, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Style="{StaticResource SecondaryText}" />

            <!-- §5.5: the fallback must be observable, not inferred from how long the scan took. -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasRouteNote, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Informational"
                     Message="{x:Bind ViewModel.RouteNote, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
