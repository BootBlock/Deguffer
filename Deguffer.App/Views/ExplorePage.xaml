<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:exploring="using:Deguffer.Core.Exploring"
    xmlns:vm="using:Deguffer.App.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <!--
            Two ways of drawing one drive. The list is where the choice is made, so it carries the
            label and the three space figures. The box states the mount point alone, at exactly the
            width it always had: the toolbar has no room to spare at the window's default size, and
            a box carrying the label pushed the scope chip's button off the end of it. See
            DriveEntryTemplates for how the two are told apart.
        -->
        <DataTemplate x:Key="DriveChosen" x:DataType="exploring:DriveChoice">
            <TextBlock Text="{x:Bind RootPath}" />
        </DataTemplate>

        <!--
            The label column is a fixed width so the space figures line up down the list. Ragged
            ones are read a row at a time; a column is read at a glance.

            Each row states its own name, because a templated item is otherwise announced as its
            parts in layout order with nothing between them.
        -->
        <DataTemplate x:Key="DriveListed" x:DataType="exploring:DriveChoice">
            <Grid ColumnSpacing="8" ColumnDefinitions="Auto,116,Auto"
                  AutomationProperties.Name="{x:Bind Description}">
                <TextBlock Grid.Column="0" Text="{x:Bind RootPath}" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind LabelText}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind Sizes}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <controls:DriveEntryTemplates x:Key="DriveEntry"
                                      Chosen="{StaticResource DriveChosen}"
                                      Listed="{StaticResource DriveListed}" />
    </Page.Resources>

    <Grid Padding="20,12,20,16" RowSpacing="10"
          RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!--
            What to scan, the actions, and how to draw it, on one line. The drive and the folder sit
            at the left where the reading starts, and the view sits at the right beside the picture
            it governs — a control that changes how something is drawn belongs next to the drawing,
            not next to the thing that produced the data.
        -->
        <Grid Grid.Row="0" ColumnSpacing="8" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
            <!-- Disabled while a scan runs, because choosing a drive drops a folder scope: the
                 page would otherwise stop naming the folder it is still scanning. -->
            <ComboBox Grid.Column="0"
                      MinWidth="88"
                      Header="Drive"
                      IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.Drives}"
                      SelectedItem="{x:Bind ViewModel.SelectedDrive, Mode=TwoWay}"
                      ItemTemplateSelector="{StaticResource DriveEntry}"
                      DropDownOpened="OnDriveListOpened"
                      AutomationProperties.Name="Drive to scan" />

            <!-- Scoping to a folder, through the system picker for the reason the source folders
                 use one: the path is then one the shell confirmed exists rather than a typed
                 string. -->
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Folder…"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    Click="OnChooseFolder"
                    AutomationProperties.Name="Choose a folder to scan" />

            <Button Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Scan"
                    Command="{x:Bind ViewModel.ScanCommand}" />

            <Button Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Content="Cancel"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ScanCancelCommand}" />

            <!-- The folder a scan is scoped to, beside the drive box it overrides. Here rather than
                 in the status line below, because it is half of the same choice as the drive — and
                 a scope stated somewhere else is a scope people scan past. -->
            <Grid Grid.Column="4"
                  ColumnSpacing="6"
                  VerticalAlignment="Bottom"
                  ColumnDefinitions="Auto,*,Auto"
                  Visibility="{x:Bind ViewModel.IsScopedToFolder, Mode=OneWay}">
                <FontIcon Grid.Column="0"
                          Glyph="&#xE8B7;"
                          FontSize="14"
                          VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.ScopeFolder, Mode=OneWay}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.ScopeFolder, Mode=OneWay}" />

                <!-- This clears the folder; it does not start anything. The accessible name says
                     so, because it is the only thing a screen reader announces. -->
                <Button Grid.Column="2"
                        Content="Whole drive"
                        Command="{x:Bind ViewModel.ScanWholeDriveCommand}"
                        ToolTipService.ToolTip="Clear the folder, so the next scan covers the whole drive"
                        AutomationProperties.Name="Clear the folder" />
            </Grid>

            <!-- §5.5's fallback made actionable, on the same terms the Storage page offers it:
                 offered from the start, and withdrawn once a scan has shown that elevating would
                 not help. -->
            <Button Grid.Column="5"
                    VerticalAlignment="Bottom"
                    Content="{x:Bind ViewModel.ElevateLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CanElevate, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ElevateAndRescanCommand}" />

            <!-- These are indexed against ExploreView, so the order here is the order of that
                 enum. The three pictures come before the list because that is the order they are
                 read in, not because the numbers demand it. -->
            <ComboBox x:Name="ViewSelector"
                      Grid.Column="6"
                      MinWidth="120"
                      Header="View"
                      SelectionChanged="OnViewSelectionChanged"
                      AutomationProperties.Name="How to draw what was scanned">
                <ComboBoxItem Content="Treemap" />
                <ComboBoxItem Content="Icicle" />
                <ComboBoxItem Content="Sunburst" />
                <ComboBoxItem Content="List" />
            </ComboBox>

            <!-- Beside the View box because the two are one decision to the reader — what is on
                 screen and what its colours mean — and orthogonal to it in fact: every pairing of
                 the two is meaningful. Indexed against ExploreColouring, like the box above it. -->
            <ComboBox x:Name="ColourSelector"
                      Grid.Column="7"
                      MinWidth="110"
                      Header="Colour"
                      SelectionChanged="OnColourSelectionChanged"
                      AutomationProperties.Name="What the colours on the map say">
                <ComboBoxItem Content="Branch" />
                <ComboBoxItem Content="Age" />
            </ComboBox>
        </Grid>

        <!--
            Determinate where the route knows its own denominator and indeterminate where it does
            not. A walk cannot count the directories it has not opened yet, and a bar that invents
            a total runs to nine tenths and stops there for a minute.
        -->
        <ProgressBar Grid.Row="1"
                     Height="3"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                     IsIndeterminate="{x:Bind ViewModel.HasNoProgressFraction, Mode=OneWay}"
                     Maximum="1"
                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />

        <!--
            Where you are, and the way back out. A breadcrumb rather than a path in a label: every
            tool in this category lets you climb back by clicking a step, and a label does not.
        -->
        <Grid Grid.Row="2" ColumnSpacing="8" ColumnDefinitions="Auto,*"
              Visibility="{x:Bind ViewModel.HasTree, Mode=OneWay}">
            <Button Grid.Column="0"
                    Padding="8,4"
                    Command="{x:Bind ViewModel.AscendCommand}"
                    ToolTipService.ToolTip="Go up one level"
                    AutomationProperties.Name="Go up one level">
                <FontIcon Glyph="&#xE74A;" FontSize="12" />
            </Button>

            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.Trail}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExploreCrumb">
                        <HyperlinkButton Content="{x:Bind Name}"
                                         Padding="4,2"
                                         Tag="{x:Bind Node}"
                                         Click="OnCrumbClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--
            The map and the list are the same data, so exactly one is on screen at a time and both
            are bound to the same current node. Kept as two controls rather than one that switches
            its own template: a list is a list, and rebuilding a bitmap through a ListView's item
            machinery would be the wrong shape for both.

            Both hide their accelerator tooltips. Auto placement turns a control's first accelerator
            into a tooltip over the whole of it, so each of these grew a "Delete" that followed the
            pointer across every row and every shape — an answer to a question nobody asked, sitting
            over the one action that cannot be undone. The menu below names all five, which is where
            somebody looks for them.
        -->
        <Border Grid.Row="3"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <controls:ExploreMap x:Name="Map"
                                     KeyboardAcceleratorPlacementMode="Hidden">
                    <!--
                        What the thing under the pointer actually is, where the app knows. Not the
                        size and not the date, which are on the status line below and are read
                        without waiting for anything.

                        A floating tooltip, where the readout below deliberately is not, and the
                        difference is how often it appears. A path and a size change on every shape,
                        so a popup carrying those never settles; this one has something to say about
                        a handful of shapes on a whole drive, and stays away over the rest. That is
                        what the collapse below does — a ToolTip with nothing in it is still a
                        rounded box that follows the pointer.
                    -->
                    <ToolTipService.ToolTip>
                        <ToolTip MaxWidth="420"
                                 Content="{x:Bind ViewModel.HoveredNote, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasHoveredNote, Mode=OneWay}">
                            <ToolTip.ContentTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ToolTip.ContentTemplate>
                        </ToolTip>
                    </ToolTipService.ToolTip>

                    <controls:ExploreMap.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteInvoked" />
                        <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="OnDeletePermanentlyInvoked" />
                        <KeyboardAccelerator Key="Enter" Invoked="OnOpenInvoked" />
                        <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="OnPropertiesInvoked" />
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnRevealInvoked" />
                    </controls:ExploreMap.KeyboardAccelerators>
                </controls:ExploreMap>

                <!--
                    Extended selection, so §7.1's "one selection at a time" can still be several
                    files the user picked out by hand. Clicking selects and double-clicking descends,
                    which is the file-manager idiom and the only arrangement that leaves a single
                    click free to mean "this one".
                -->
                <ListView x:Name="RowsList"
                          Visibility="Collapsed"
                          SelectionMode="Extended"
                          KeyboardAcceleratorPlacementMode="Hidden"
                          SelectionChanged="OnRowSelectionChanged"
                          DoubleTapped="OnRowsDoubleTapped"
                          ItemsSource="{x:Bind ViewModel.Rows}">
                    <ListView.ContextFlyout>
                        <!--
                        One menu, opened by hand from the list and from the map. Two things forced
                        that, both measured rather than reasoned about: an attached ContextFlyout on
                        this ListView never appears, and neither ContextRequested nor RightTapped
                        reaches an ordinary handler on it, because a ListViewItem marks the gesture
                        handled on its way past. The page subscribes past that in code, which is why
                        no right-click handler is declared here.

                        It is still declared here, and not as a page resource, because that is what
                        gives it a lifetime: a StaticResource flyout is built on first use, and the
                        x:Bind below runs when the page loads — which crashed the app outright,
                        setting Command on an item that did not exist yet.

                        Showing it by hand is also what lets the right-click move the selection onto
                        the row it landed on first.

                        The four actions are what §7.1 lets Explore do with something the user picked
                        out by hand: three that change nothing, and a removal that goes to the
                        Recycle Bin unless the user asks for the other one by name.

                        The accelerators are declared on the two surfaces rather than here, because a
                        flyout item's accelerator only fires while the flyout is open — which is
                        exactly when the keyboard is not what the user is reaching for. These carry
                        the text so the menu still teaches them.
                    -->
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open"
                                        Command="{x:Bind ViewModel.Selection.OpenCommand}"
                                        KeyboardAcceleratorTextOverride="Enter">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem Text="Open containing folder"
                                        Command="{x:Bind ViewModel.Selection.RevealCommand}"
                                        KeyboardAcceleratorTextOverride="Ctrl+Enter">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC50;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem Text="Delete"
                                        Command="{x:Bind ViewModel.Selection.DeleteCommand}"
                                        KeyboardAcceleratorTextOverride="Del">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <!-- Named for what it does, not for a modifier key. §7.1 makes this the deliberate
                             second choice, and a choice the user has to infer is not a deliberate one. -->
                        <MenuFlyoutItem Text="Delete permanently"
                                        Command="{x:Bind ViewModel.Selection.DeletePermanentlyCommand}"
                                        KeyboardAcceleratorTextOverride="Shift+Del">
                            <MenuFlyoutItem.Icon>
                                <!-- The same glyph as Delete above, deliberately. These are two
                                     deletions and the words are what tell them apart; the codepoint
                                     next to it in the font is an arrow, and a wrong picture beside
                                     the one irreversible action is worse than a repeated right
                                     one. -->
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem Text="Properties"
                                        Command="{x:Bind ViewModel.Selection.PropertiesCommand}"
                                        KeyboardAcceleratorTextOverride="Alt+Enter">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                    </ListView.ContextFlyout>

                    <ListView.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteInvoked" />
                        <KeyboardAccelerator Key="Delete" Modifiers="Shift" Invoked="OnDeletePermanentlyInvoked" />
                        <KeyboardAccelerator Key="Enter" Invoked="OnOpenInvoked" />
                        <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="OnPropertiesInvoked" />
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnRevealInvoked" />
                    </ListView.KeyboardAccelerators>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExploreRow">
                            <!-- Transparent rather than unset, so the whole row carries the
                                 tooltip. A panel with no background is not hit-tested, so the
                                 gaps between the columns fall through and the exact dates are
                                 reachable only by landing on a word — which is precisely where a
                                 reader is not pointing when they are reading the age column. -->
                            <Grid ColumnSpacing="12" Padding="0,4"
                                  Background="Transparent"
                                  ColumnDefinitions="16,*,120,90,150"
                                  AutomationProperties.Name="{x:Bind Description, Mode=OneWay}"
                                  AutomationProperties.HelpText="{x:Bind Tip, Mode=OneWay}">
                                <!--
                                    The two dates, and where the app knows the name, what the thing
                                    is and whether deleting it recovers anything.

                                    Wrapped by hand, because a tooltip's default presenter does not
                                    wrap: an explanation set on it as a plain string is one line as
                                    wide as the sentence, off the side of the window.

                                    Said again as help text above, because a tooltip is not an
                                    accessible surface here. Measured: a plain-string tooltip
                                    elsewhere on this page reports no HelpText either, so this is not
                                    a WPF-style fallback that templating the content took away —
                                    WinUI simply does not carry a tooltip into the automation tree,
                                    and the same row of text has to be given twice. It is the rule
                                    ExploreRowText already states for the size column: what only the
                                    eye can reach gets said in words as well.
                                -->
                                <ToolTipService.ToolTip>
                                    <ToolTip MaxWidth="420" Content="{x:Bind Tip, Mode=OneWay}">
                                        <ToolTip.ContentTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ToolTip.ContentTemplate>
                                    </ToolTip>
                                </ToolTipService.ToolTip>

                                <FontIcon Grid.Column="0"
                                          FontSize="14"
                                          Glyph="{x:Bind Icon}"
                                          AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- The bar is scaled against the containing folder, so the row
                                     answers "how much of this folder is that" rather than "how does
                                     it compare with the biggest thing here". -->
                                <ProgressBar Grid.Column="2"
                                             VerticalAlignment="Center"
                                             Maximum="100"
                                             Value="{x:Bind Share, Mode=OneWay}"
                                             AutomationProperties.AccessibilityView="Raw" />

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind SizeLabel, Mode=OneWay}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryText}" />

                                <!-- The newest write at or below the row, not the row's own
                                     timestamp — a folder's own date moves when its layout changes
                                     and stands still while its contents are rewritten. The exact
                                     dates, and which is which, are on the row's tooltip. -->
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind AgeLabel, Mode=OneWay}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The empty state. A large blank card reads as a screen that has failed rather
                     than one waiting to be told to start. -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                            Visibility="{x:Bind ViewModel.HasNoTree, Mode=OneWay}">
                    <TextBlock Text="Nothing scanned yet"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Choose a drive or a folder and press Scan. Nothing is changed by looking."
                               HorizontalAlignment="Center"
                               Style="{StaticResource SecondaryText}" />
                </StackPanel>

                <!--
                    The notes, over the picture rather than under it.

                    A refusal arrives and goes with each click, and the other three open and close
                    across a scan. Below the card they were part of the status area's height, so the
                    card was given a new size on each one and the drawing inside it was rebuilt at
                    that size — and a size picture that changes size while it is being read is a
                    picture nobody can read.

                    So they cover rather than displace, and nothing the user does to what is on
                    the card can resize it. What is left above it still can: the progress bar and
                    the breadcrumb appear and go with a scan, and the colour legend below follows
                    the Colour and View boxes. Each of those is a deliberate act at a moment the
                    picture is being rebuilt anyway, which is the opposite of what this fixes.

                    The sentences let the pointer through, and only the two buttons take it. The map has no keyboard way round a shape, and the stale note stands
                    until the next scan rather than until the next click, so a hit-testable strip
                    over the drawing would put part of the picture out of reach for the rest of the
                    session. Text has nothing to click anyway, so the shapes underneath stay
                    reachable and the hover line goes on naming whatever is under the pointer.

                    The reader can put the whole panel away, and it stays away across launches. It
                    collapses to the button below rather than going, so nothing it was carrying is
                    lost — §7.1's refusal and §5.5's route sentence become one activation away, which
                    is the standard §7 already sets for a Storage row's own disclosure. Nothing but
                    the reader reopens it: a note arriving later brings the button back, never the
                    panel.

                    The list is the one view that cannot be covered, because rows underneath one
                    are rows nothing can retrieve, so OnNotesResized ends it above them.

                    The ground under them is what makes them readable at all. An InfoBar's
                    severity colour is a tint over whatever is behind it, so on a page it reads
                    against the page and here it read against a treemap — measured, and with no
                    ground of its own the text was all but gone against a yellow tile.

                    That ground is now carried at three quarters, and the button below it at a
                    half, which the maintainer asked for and which gives back some of the contrast
                    the measurement bought. §6.5 is untouched by it either way: that section is
                    about the backdrop going away, and nothing here reads any differently when it
                    does. Anyone lowering these further should measure again rather than reason
                    about it.
                -->
                <Grid x:Name="Notes"
                      VerticalAlignment="Bottom"
                      Margin="12"
                      SizeChanged="OnNotesResized">
                    <!--
                        The banner: the sentences, and the button that puts them away. They are
                        siblings rather than parent and child, because IsHitTestVisible is not a
                        property a child can win back — set on the panel, it takes the whole subtree
                        inside it with it, and the close button with it. Grouping them under one grid
                        is what lets a single opacity and a single visibility cover the pair, and the
                        grid paints nothing, so it is not hit-tested and the shapes underneath stay
                        reachable through it.

                        Three quarters opaque, at the maintainer's asking. It reads as laid over the
                        picture rather than part of it, at some cost to the contrast the opaque ground
                        below was there to give (§6.5).
                    -->
                    <Grid Opacity="0.75" Visibility="{x:Bind ViewModel.ShowsNotes, Mode=OneWay}">
                        <Grid.Resources>
                            <!--
                                The banner is one surface, so nothing inside it paints a second one.
                                The Border below is the ground; an informational note's severity tint,
                                its stroke, and the dismiss button's fill each landed a lighter slab on
                                top of it, which read as a step at the gutter and a square in the corner.
                                Measured in dark: #292929 tint, #222222 stroke, #252525 ground, #2E2E2E
                                button, on one line across a banner that should be one colour.

                                Turned off at the theme keys rather than as properties on the elements.
                                A local property wins in every theme at once, and High Contrast is the
                                one theme where all of this is load-bearing: there a Button's fill and
                                stroke are the whole statement that it is a control, and an InfoBar's
                                2px WindowText border is what separates one note from the next once
                                every severity has collapsed to the window colour. So the clearing is
                                scoped to the themes that asked for it.

                                The empty HighContrast dictionary is doing work and must stay. A theme
                                with no dictionary of its own falls back to Default, so deleting it does
                                not restore the SDK's values — it hands High Contrast the transparent
                                ones. Empty, the lookup misses here and walks up to the SDK's own.

                                Default and Light repeat each other because ThemeDictionaries has no
                                way to share an entry between two themes. generic.xaml spells the
                                InfoBar's own close button out three times for the same reason.
                            -->
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent" />
                                        <Thickness x:Key="InfoBarBorderThickness">0</Thickness>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    </ResourceDictionary>

                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent" />
                                        <Thickness x:Key="InfoBarBorderThickness">0</Thickness>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                    </ResourceDictionary>

                                    <ResourceDictionary x:Key="HighContrast" />
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>

                        <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                Padding="0,0,36,0"
                                IsHitTestVisible="False">
                            <!--
                                Each note states its visibility as well as opening, and the two say the
                                same thing on purpose. A closed InfoBar collapses its template's content
                                and stays Visible itself, so a StackPanel still spaces it against its
                                neighbours: four closed notes left an 18px bar of the backing painted
                                across the map at all times, and took thirty pixels off the list for
                                nothing. Collapsed, they cost the spacing as well as the height.
                            -->
                            <StackPanel Spacing="6">
                                <!-- §7.1: a refusal is stated with its reason rather than by greying something
                                     out. Said as soon as something is selected, because a menu item that does
                                     nothing teaches nothing. -->
                                <InfoBar IsOpen="{x:Bind ViewModel.Selection.HasNote, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.Selection.HasNote, Mode=OneWay}"
                                         IsClosable="False"
                                         Severity="Informational"
                                         Message="{x:Bind ViewModel.Selection.Note, Mode=OneWay}" />

                                <!-- The picture stops matching the disk the moment something is removed from
                                     it, and rebuilding it means rescanning the drive. §7.1 allows the numbers
                                     to be off provided the picture says which way.

                                     This one keeps its ground, deliberately, and reaches it by a key the
                                     override above does not name. What it says is a claim a deletion
                                     decision rests on. A tint carried by every note is decoration; a tint
                                     carried by the one note that cautions is a signal, and this is now the
                                     only tinted thing on the panel. -->
                                <InfoBar IsOpen="{x:Bind ViewModel.Selection.HasStaleNote, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.Selection.HasStaleNote, Mode=OneWay}"
                                         IsClosable="False"
                                         Severity="Warning"
                                         Message="{x:Bind ViewModel.Selection.StaleNote, Mode=OneWay}" />

                                <!-- Where what is on screen is not what the View box names. A scan in progress
                                     is ordered by name so that it stays still, and a treemap cannot be drawn
                                     from that at all — so the map substitutes the icicle. A substitution
                                     nobody is told about is the kind a user reads as a bug.

                                     An InfoBar rather than the bare line this was, because it has joined
                                     a stack of three of them. A line of secondary text between two InfoBars
                                     has no icon, no padding and no severity, so it reads as something that
                                     failed to render rather than as the fourth note. -->
                                <InfoBar IsOpen="{x:Bind ViewModel.HasViewNote, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.HasViewNote, Mode=OneWay}"
                                         IsClosable="False"
                                         Severity="Informational"
                                         Message="{x:Bind ViewModel.ViewNote, Mode=OneWay}" />

                                <!-- §5.5: the fallback must be observable, not inferred from how long the scan
                                     took. -->
                                <InfoBar IsOpen="{x:Bind ViewModel.HasRouteNote, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.HasRouteNote, Mode=OneWay}"
                                         IsClosable="False"
                                         Severity="Informational"
                                         Message="{x:Bind ViewModel.RouteNote, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!--
                            Closes the lot, rather than one note at a time. What the reader is turning down
                            is the panel over their picture, not this sentence as against that one, and four
                            close buttons would ask them to say it four times. The gutter above is what it
                            sits in, so it is never over a word.

                            Its rest fill and stroke are cleared by the ButtonBackground and
                            ButtonBorderBrush entries above, which reach this button and no other:
                            the collapsed ShowNotes button is outside this grid, and it needs the
                            fill it has. Only the rest state goes. Pointer-over, pressed and disabled
                            are driven by storyboards against the template's own ContentPresenter, so
                            they still paint, and the focus visual is drawn by the framework rather
                            than from BorderBrush. A button that answers nothing under the pointer,
                            or that a keyboard cannot find, would be a worse fault than the one this
                            fixes.
                        -->
                        <Button x:Name="DismissNotes"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,4,4,0"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Click="OnDismissNotes"
                                ToolTipService.ToolTip="Hide these notes. They stay one click away."
                                AutomationProperties.Name="Hide these notes">
                            <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!--
                        What the panel collapses to, in the corner the panel had, and inside the
                        same container so that one measurement covers both. Over the map it
                        reserves nothing, which is the point of it. Over the list it does, because
                        this grid is what ends the list: a button sitting on the last row's date is
                        not out of the way, and a row underneath one is a row nothing can retrieve.

                        On a ground of its own, for the reason the panel has one: a button's own
                        fill is a tint, and a tint alone over a treemap is not a button anybody can
                        find. Half opaque over that, at the maintainer's asking, so that it sits
                        back from the picture it is drawn on — which is the smallest target here
                        and the one that carries the warning glyph, so it is the first place to
                        look if these values are ever lowered again.
                    -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            CornerRadius="16"
                            Opacity="0.5"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            Visibility="{x:Bind ViewModel.ShowsNotesButton, Mode=OneWay}">
                        <Button x:Name="ShowNotes"
                                Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="16"
                                Click="OnShowNotes"
                                ToolTipService.ToolTip="{x:Bind ViewModel.NotesButtonLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.NotesButtonLabel, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.NotesButtonGlyph, Mode=OneWay}" FontSize="14" />
                        </Button>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Spacing="6">
            <!-- What the pointer is over. A status line rather than a floating tooltip: over tens
                 of thousands of rectangles a popup that follows the pointer never settles.

                 One line, and the same one line whatever it says. SecondaryText wraps, so this took
                 a second line for a path long enough to need one and gave it back over the next
                 shape — which is the card above being handed a new size on every pointer move.

                 The figures sit in a column of their own so that what a long path costs is its own
                 tail rather than the size beside it. The size is the answer this page exists to
                 give, and the trimmed tail is the part the map has already drawn on the shape
                 itself. -->
            <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto" MinHeight="20">
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.Hovered, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.Hovered, Mode=OneWay}" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.HoveredFigures, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="NoWrap" />
            </Grid>

            <!-- What is picked. The three pictures have no selection outline, so without this a
                 right-click on a tile would open a menu about something nothing on screen names.

                 Two reserved lines, and it wraps into them rather than trimming. That is the
                 difference between this line and the hover line above: that one is a readout that
                 changes with the pointer, and this one names what Delete will act on. §7.1 turns
                 on the user having picked the thing out by hand, so a path this cut short at the
                 leaf — the one segment that tells two folders apart — would be the page naming
                 something other than the target. Two lines hold every path either picture is
                 likely to draw, and the floor keeps them there whether or not anything is
                 selected. -->
            <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto" MinHeight="40">
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.Selection.Label, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.Selection.Figures, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Top"
                           TextWrapping="NoWrap" />
            </Grid>

            <!-- What the colours mean, when they mean an age. A hue per branch needs no legend,
                 because the branch it names is the shape it is inside; an age band means nothing
                 at all without the scale beside it. -->
            <!-- One row that scrolls rather than a wrapping one. ItemsWrapGrid gives every cell
                 the width of the first, so "Today" sized the whole legend and clipped every band
                 after it; the panels that size each item to its own content are not in the
                 framework. A narrow window scrolls this instead, which is what the rest of the app
                 does with content too wide for its container. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled"
                          Visibility="{x:Bind ViewModel.ShowsAgeLegend, Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind ViewModel.AgeLegend}"
                          AutomationProperties.Name="What the map's colours mean">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExploreLegendBand">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,12,0"
                                    AutomationProperties.Name="{x:Bind Label}">
                            <Border Width="12" Height="12" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind Swatch}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind Label}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- Wraps as far as it needs to, and is never cut short. This is the one surface
                 that carries what a removal did: §5.6's verification result arrives appended to
                 the end of that sentence, and a wholly refused selection reports the policy's
                 reason here verbatim rather than through a dialog. Trimming the tail would take
                 the sentence saying a deletion may have removed something it was not asked to,
                 and leave the part saying it worked. So this one is allowed to change height, and
                 it does so when a scan starts or ends or a removal reports — never while the map
                 is being read. -->
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Page>
