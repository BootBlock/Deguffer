<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:shell="using:Deguffer.App.Shell"
    Background="Transparent">

    <Page.Resources>
        <!-- A page's name, then what About says of it, one sentence a line. The summary of what each
             page is for and the account of what each can undo read the same way. -->
        <DataTemplate x:Key="PageStatementTemplate" x:DataType="shell:PageStatement">
            <StackPanel Spacing="{StaticResource LabelGap}">
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind Sentences}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource LabelGap}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Style="{StaticResource SecondaryText}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <!-- The header is a row of its own, outside the scroller, so the starfield in the row below is
         never behind its words, and every other word on the page is on a card. -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="{StaticResource RegionGap}" RowDefinitions="Auto,*">

        <controls:PageHeader Destination="About" />

        <!-- To the page's edges, under the padding the cards keep. -->
        <controls:Starfield x:Name="Field" Grid.Row="1" Margin="{StaticResource PageBleed}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="{StaticResource RegionGap}" MaxWidth="720" HorizontalAlignment="Left">

                <!-- Drawn above the cards after it, so the mark passes over them as it flies in out
                     of the stars behind them. -->
                <Border Canvas.ZIndex="1" Style="{StaticResource SolidCardStyle}">
                    <StackPanel Spacing="{StaticResource ControlGap}">
                        <!-- The version belongs with the build date and the architecture in the card
                             below, not beside the name as well; the same number twice, two lines
                             apart, only invites the reader to check whether it is the same number. -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- Decoded at the size it settles at, in the reader's own pixels: the
                                 source is the 256px master. -->
                            <Image x:Name="Mark" Width="32" Height="32" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw">
                                <Image.Source>
                                    <BitmapImage UriSource="ms-appx:///Assets/Deguffer-256.png"
                                                 DecodePixelType="Logical" DecodePixelWidth="32" DecodePixelHeight="32" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="Deguffer" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SecondaryText}" Text="{x:Bind Summary}" />
                    </StackPanel>
                </Border>

                <!-- Directly under the name, because "which build is this" is what an about box is
                     asked first, and the links belong beside it rather than at the foot of a page
                     nobody scrolls to. The scanning mode is here too: it is diagnostic, the
                     difference between a scan that takes seconds and one that takes minutes, and a
                     bug report needs it with the rest, which Copy details puts on the clipboard. -->
                <Border Style="{StaticResource SolidCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="20" RowSpacing="8" ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Details.Version}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Built"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Details.BuildDateText}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />

                            <!-- The architecture is meaningless to most readers on its own, so the
                                 explanation has to reach every one of them. A TextBlock cannot take
                                 focus, so a tooltip on one serves a pointer and nobody else, which is
                                 why the value sits in a tab-stoppable ContentControl: the tooltip then
                                 opens on keyboard focus as well as on hover, and the sentence is
                                 HelpText on that one element. On both elements it would be announced
                                 twice. The label keeps a tooltip of its own because a pointer lands on
                                 the word as readily as on the value, and a duplicate tooltip string,
                                 unlike a duplicate HelpText, is only ever shown one at a time. -->
                            <TextBlock x:Name="ArchitectureLabel"
                                       Grid.Row="2" Grid.Column="0" Text="Architecture"
                                       Style="{StaticResource FieldLabel}"
                                       ToolTipService.ToolTip="{x:Bind ArchitectureExplanation}" />
                            <ContentControl Grid.Row="2" Grid.Column="1"
                                            IsTabStop="True"
                                            UseSystemFocusVisuals="True"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind ArchitectureExplanation}"
                                            AutomationProperties.LabeledBy="{x:Bind ArchitectureLabel}"
                                            AutomationProperties.HelpText="{x:Bind ArchitectureExplanation}">
                                <TextBlock Text="{x:Bind Details.ArchitectureText}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </ContentControl>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Windows"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind Details.WindowsText}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Scanning"
                                       Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="{StaticResource LabelGap}">
                                <TextBlock Text="{x:Bind Details.ScanModeText}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ScanModeExplanation}" Style="{StaticResource Caption}" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Author"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Joe Cox"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Built in"
                                       Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Scunthorpe, England"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <!-- What a bug report needs, as plain text with no path in it. -->
                        <controls:FlowRow ColumnSpacing="{StaticResource ControlGap}" RowSpacing="{StaticResource ControlGap}">
                            <Button x:Name="CopyDetailsButton"
                                    Content="Copy details"
                                    AutomationProperties.HelpText="Copies the version, build date, architecture, Windows version and scanning mode, to paste into a bug report."
                                    Click="OnCopyDetails" />
                            <TextBlock x:Name="CopyDetailsResult"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" />
                        </controls:FlowRow>

                        <!-- The issue tracker leads, because a problem is why most readers look for a
                             link here, and its new-issue page offers the report forms. -->
                        <controls:FlowRow ColumnSpacing="{StaticResource RegionGap}" RowSpacing="{StaticResource ControlGap}">
                            <HyperlinkButton x:Name="ReportProblemLink"
                                             Content="Report a problem"
                                             NavigateUri="https://github.com/BootBlock/Deguffer/issues/new/choose"
                                             Padding="0" />
                            <HyperlinkButton x:Name="RepositoryLink"
                                             Content="GitHub repository"
                                             NavigateUri="https://github.com/BootBlock/Deguffer"
                                             Padding="0" />
                            <HyperlinkButton x:Name="AuthorSiteLink"
                                             Content="bootblock.co.uk"
                                             NavigateUri="https://bootblock.co.uk"
                                             Padding="0" />
                            <HyperlinkButton x:Name="AuthorProfileLink"
                                             Content="BootBlock on GitHub"
                                             NavigateUri="https://github.com/BootBlock?tab=repositories"
                                             Padding="0" />
                        </controls:FlowRow>
                    </StackPanel>
                </Border>


                <!-- One line a page, in the words its rail item states, after the build's details
                     because "which build is this" is asked first. -->
                <Border Style="{StaticResource SolidCardStyle}">
                    <StackPanel Spacing="{StaticResource ControlGap}">
                        <TextBlock Text="{x:Bind PurposesHeading}" Style="{StaticResource GroupHeading}" />
                        <ItemsControl ItemsSource="{x:Bind Purposes}" IsTabStop="False"
                                      ItemTemplate="{StaticResource PageStatementTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource ControlGap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SolidCardStyle}">
                    <StackPanel Spacing="{StaticResource RegionGap}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="The safety tiers" Style="{StaticResource GroupHeading}" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Text="{x:Bind TiersIntroduction}" />
                        </StackPanel>

                        <!-- The names are SafetyTier's own, the ones a Storage row's badge and its
                             dialogs show, so About cannot call a tier something the rows do not. -->
                        <ItemsControl ItemsSource="{x:Bind Tiers}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource RegionGap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="shell:TierStatement">
                                    <StackPanel Spacing="{StaticResource LabelGap}">
                                        <ContentControl Content="{x:Bind Name}"
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        Style="{x:Bind Tier, Converter={StaticResource TierChipStyle}}"
                                                        HorizontalAlignment="Left" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{x:Bind Explanation}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Said page by page, because the pages differ: Storage removes outright, Explore and
                     Duplicates use the Recycle Bin, Installed apps keeps a backup, Startup's Disable
                     is undone by Enable, and the rest change nothing. -->
                <Border Style="{StaticResource SolidCardStyle}">
                    <StackPanel Spacing="{StaticResource ControlGap}">
                        <TextBlock Text="{x:Bind SafeguardsHeading}" Style="{StaticResource GroupHeading}" />
                        <ItemsControl ItemsSource="{x:Bind Safeguards}" IsTabStop="False"
                                      ItemTemplate="{StaticResource PageStatementTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource ControlGap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The licence, then what ships inside each build under its own: every build is
                     self-contained (§6.3), so .NET and the Windows App SDK are redistributed in it
                     beside the referenced packages, and their licences expect the credit. -->
                <Border Style="{StaticResource SolidCardStyle}">
                    <StackPanel Spacing="{StaticResource ControlGap}">
                        <TextBlock Text="Licences" Style="{StaticResource GroupHeading}" />
                        <TextBlock Style="{StaticResource SecondaryText}">
                            <Run Text="Deguffer is open source under the" />
                            <Hyperlink NavigateUri="https://github.com/BootBlock/Deguffer/blob/main/LICENSE">MIT licence</Hyperlink><Run Text=". Each build includes these components, under their own licences:" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{x:Bind Components}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource LabelGap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="shell:ThirdPartyComponent">
                                    <controls:FlowRow ColumnSpacing="{StaticResource ControlGap}" RowSpacing="{StaticResource LabelGap}">
                                        <TextBlock Text="{x:Bind Name}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <HyperlinkButton Content="{x:Bind Licence}"
                                                         NavigateUri="{x:Bind LicenceUri}"
                                                         Padding="0"
                                                         AutomationProperties.Name="{x:Bind LicenceLinkName}"
                                                         AutomationProperties.AutomationId="{x:Bind LicenceLinkName}" />
                                    </controls:FlowRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
