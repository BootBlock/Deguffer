<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Deguffer.App.Views.MapAppearanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels"
    xmlns:config="using:Deguffer.Core.Configuration"
    xmlns:controls="using:Deguffer.App.Controls">

    <!--
        A window of its own rather than a dialog on the page, because the point of it is to watch
        the map change: a ContentDialog greys out and covers the page it belongs to, and a flyout
        sits on the toolbar over the top of the picture. This one opens beside the main window where
        the screen has room, and the reader can move it wherever it is out of the way.

        On a solid ground rather than a backdrop, so it reads the same with the backdrop off (§6.5).

        The choices are in tabs by what they change, with the preview above them all, so whichever tab
        is open the reader sees what a choice does. Every box is indexed against the enum it sets, in
        the enum's order.
    -->
    <Grid x:Name="Root"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          Padding="20,16,20,20"
          RowSpacing="8"
          RowDefinitions="Auto,*,Auto,Auto">

        <!-- What each choice below does, drawn as it is made, from an invented picture that names no
             folder on the machine. The map itself can be behind this window or on another page. -->
        <controls:MapPreview x:Name="Preview" Grid.Row="0" Height="160" />

        <Pivot Grid.Row="1" IsHeaderItemsCarouselEnabled="False" AutomationProperties.Name="Map appearance">

            <!-- The headers at a body size rather than the Pivot's own display size, and in a
                 fixed order rather than turning to put the open one first, so all five fit
                 across the tool window in the same place each time. -->
            <Pivot.Resources>
                <x:Double x:Key="PivotHeaderItemFontSize">15</x:Double>
            </Pivot.Resources>

            <!-- A preset sets the shading, the lines, the folders and the spacing at once, and for a
                 look whose colours are part of it, the page's Colour box as well. -->
            <PivotItem Header="Presets">
                <Grid RowSpacing="8" RowDefinitions="Auto,*">
                    <TextBlock Text="{x:Bind ViewModel.PresetSummary, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Style="{StaticResource SecondaryText}" />

                    <ListView Grid.Row="1"
                              SelectionMode="Single"
                              ItemsSource="{x:Bind ViewModel.Presets}"
                              SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}"
                              AutomationProperties.Name="Presets">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="config:MapPreset">
                                <StackPanel Padding="0,8"
                                            Spacing="2"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            AutomationProperties.HelpText="{x:Bind Description}">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Colours">
                <Grid RowSpacing="8" RowDefinitions="Auto,*,Auto">

                    <!-- Which picture the list below changes. One list serves all three, so the
                         heading is what tells the reader that choosing here leaves the other two as
                         they were. -->
                    <TextBlock Text="{x:Bind ViewModel.SchemeHeading, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ListView x:Name="SchemeList"
                              Grid.Row="1"
                              SelectionMode="Single"
                              ItemsSource="{x:Bind ViewModel.Schemes}"
                              SelectedIndex="{x:Bind ViewModel.SchemeIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind ViewModel.SchemeHeading, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MapSchemeOption">
                                <StackPanel Padding="0,8" Spacing="4" AutomationProperties.Name="{x:Bind Spoken}">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryText}" />

                                    <!-- Two strips: a few folders as a treemap draws its largest, and
                                         the age bands newest first. Raw to a screen reader, which is
                                         given the description above instead. -->
                                    <ItemsControl ItemsSource="{x:Bind Branches}"
                                                  Margin="0,4,0,0"
                                                  AutomationProperties.AccessibilityView="Raw">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MapSwatch">
                                                <Border Width="36" Height="14" CornerRadius="2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind Colour}" />
                                                    </Border.Background>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{x:Bind Ages}"
                                                  AutomationProperties.AccessibilityView="Raw">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MapSwatch">
                                                <Border Width="30" Height="8" CornerRadius="2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind Colour}" />
                                                    </Border.Background>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ComboBox Grid.Row="2"
                              MinWidth="200"
                              Header="Folders drawn round what they hold"
                              SelectedIndex="{x:Bind ViewModel.FolderFillIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="In their own colour" />
                        <ComboBoxItem Content="In dark grey" />
                    </ComboBox>
                </Grid>
            </PivotItem>

            <PivotItem Header="Shading">
                <ScrollViewer>
                    <StackPanel Spacing="16" Padding="0,8,0,0">
                        <ComboBox MinWidth="200"
                                  Header="How each shape is lit"
                                  SelectedIndex="{x:Bind ViewModel.ShadingIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Cushion" />
                            <ComboBoxItem Content="Bevel" />
                            <ComboBoxItem Content="Flat" />
                        </ComboBox>

                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryText}"
                                   Text="A cushion rises to the middle of each shape and falls away to its edges. A bevel is flat, lighter along the top and left edges and darker along the bottom and right. Flat is each shape in its own colour with no light on it." />

                        <ComboBox MinWidth="200"
                                  Header="Depth of a cushion or a bevel"
                                  SelectedIndex="{x:Bind ViewModel.ReliefIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Subtle" />
                            <ComboBoxItem Content="Standard" />
                            <ComboBoxItem Content="Strong" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Borders">
                <ScrollViewer>
                    <StackPanel Spacing="16" Padding="0,8,0,0">
                        <ComboBox MinWidth="200"
                                  Header="Line round each file and block"
                                  SelectedIndex="{x:Bind ViewModel.BlockBordersIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="Faint" />
                            <ComboBoxItem Content="Medium" />
                            <ComboBoxItem Content="Strong" />
                            <ComboBoxItem Content="Solid" />
                        </ComboBox>

                        <ComboBox MinWidth="200"
                                  Header="Line round each folder"
                                  SelectedIndex="{x:Bind ViewModel.FolderBordersIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="Faint" />
                            <ComboBoxItem Content="Medium" />
                            <ComboBoxItem Content="Strong" />
                            <ComboBoxItem Content="Solid" />
                        </ComboBox>

                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryText}"
                                   Text="A folder's line is drawn round a treemap folder that has what it holds drawn inside it. Every shape of the icicle and the sunburst takes the line for files." />

                        <ComboBox MinWidth="200"
                                  Header="Line width"
                                  SelectedIndex="{x:Bind ViewModel.BorderWidthIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Thin" />
                            <ComboBoxItem Content="Thick" />
                        </ComboBox>

                        <ComboBox MinWidth="200"
                                  Header="Line colour"
                                  SelectedIndex="{x:Bind ViewModel.BorderToneIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Darker than the shape" />
                            <ComboBoxItem Content="Lighter than the shape" />
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Layout">
                <ScrollViewer>
                    <StackPanel Spacing="16" Padding="0,8,0,0">

                        <!-- Indexed against ExploreSpacing, like the same box on the Settings page.
                             The two write one setting, which the Memory page's treemap follows as
                             well. -->
                        <ComboBox MinWidth="200"
                                  Header="Room round each folder in the treemap"
                                  SelectedIndex="{x:Bind ViewModel.SpacingIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Dense" />
                            <ComboBoxItem Content="Comfortable" />
                            <ComboBoxItem Content="Spacious" />
                        </ComboBox>

                        <ToggleSwitch Header="Name each folder in a band along its top"
                                      IsOn="{x:Bind ViewModel.FolderNames, Mode=TwoWay}" />

                        <ToggleSwitch Header="Write names and sizes inside shapes"
                                      IsOn="{x:Bind ViewModel.ShapeNames, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <TextBlock Grid.Row="2"
                   TextWrapping="Wrap"
                   Text="Changes show on the map as you make them. Each view keeps its own colours, and the Memory page's map uses this look too."
                   Style="{StaticResource SecondaryText}" />

        <Button Grid.Row="3"
                HorizontalAlignment="Right"
                Content="Close"
                Click="OnCloseClicked" />
    </Grid>
</Window>
