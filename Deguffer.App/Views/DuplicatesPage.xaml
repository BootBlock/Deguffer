<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <!-- One copy: its path, with what differs from the other copies' paths picked out by weight
             and an underline as well as colour, so it reads in high contrast and without colour;
             then its size and time, and what kind of copy it is. -->
        <DataTemplate x:Key="CopyTemplate" x:DataType="vm:DuplicateCopyRow">
            <Grid Padding="0,3" ColumnSpacing="12" ColumnDefinitions="*,Auto,Auto,Auto"
                  AutomationProperties.Name="{x:Bind Description}">
                <TextBlock TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                           ToolTipService.ToolTip="{x:Bind Copy.Path}">
                    <Run Text="{x:Bind Same}" /><Run Text="{x:Bind Differs}" FontWeight="Bold"
                         TextDecorations="Underline"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Run Text="{x:Bind SameEnd}" />
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <ContentControl Content="Reference" Style="{StaticResource StandingChip}"
                                    Visibility="{x:Bind IsReference}"
                                    ToolTipService.ToolTip="In a reference location: matched, and never marked or removed."
                                    AutomationProperties.AccessibilityView="Raw" />
                    <ContentControl Content="Several names" Style="{StaticResource StandingChip}"
                                    Visibility="{x:Bind HasSeveralNames}"
                                    ToolTipService.ToolTip="{x:Bind Names}"
                                    AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{x:Bind Modified}" Style="{StaticResource SecondaryText}"
                           AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Grid.Column="3" MinWidth="72" TextAlignment="Right" Text="{x:Bind Size}"
                           AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>

        <!-- One group: what it could free and what matched it, the sentence a name, size or time
             match carries, then every copy. -->
        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:DuplicateGroupRow">
            <StackPanel Padding="0,10" Spacing="4"
                        BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto"
                      AutomationProperties.Name="{x:Bind Description}">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Freeable}" Style="{StaticResource SecondaryText}" />
                </Grid>

                <TextBlock Text="{x:Bind Matched}" Style="{StaticResource SecondaryText}"
                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                           AutomationProperties.AccessibilityView="Raw" />

                <TextBlock Text="{x:Bind MayDiffer}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="{x:Bind HasMayDiffer}"
                           AutomationProperties.AccessibilityView="Raw" />

                <ItemsControl ItemsSource="{x:Bind Copies}" ItemTemplate="{StaticResource CopyTemplate}"
                              IsTabStop="False" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="GroupContainer" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,12,20,16" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <Grid Grid.Row="0" ColumnSpacing="12" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="Duplicates" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Headline, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <Button Grid.Column="1" Content="Reopen as administrator" VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.CanElevate, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ElevateCommand}"
                    ToolTipService.ToolTip="As administrator, a search reads each drive's file table, which is much faster than walking its folders." />
        </Grid>

        <!-- Where to search, beside what makes a match. Each control writes straight through: a
             location to the list, a criterion or a filter to the preferences. -->
        <Grid Grid.Row="1" ColumnSpacing="24" ColumnDefinitions="*,*">
            <StackPanel Spacing="8">
                <TextBlock Text="Where to search" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid ColumnSpacing="8" ColumnDefinitions="Auto,Auto,Auto">
                    <ComboBox MinWidth="88"
                              ItemsSource="{x:Bind ViewModel.Locations.Drives}"
                              SelectedItem="{x:Bind ViewModel.Locations.SelectedDrive, Mode=TwoWay}"
                              ItemTemplateSelector="{StaticResource DriveEntry}"
                              DropDownOpened="OnDriveListOpened"
                              AutomationProperties.Name="Drive to add" />
                    <Button Grid.Column="1" Content="Add drive" Command="{x:Bind ViewModel.Locations.AddDriveCommand}" />
                    <Button Grid.Column="2" Content="Add folder…" Click="OnAddFolder"
                            AutomationProperties.Name="Choose a folder to add" />
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.Locations.Note, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                <ListView MaxHeight="150" SelectionMode="None"
                          AutomationProperties.Name="Locations to search"
                          ItemsSource="{x:Bind ViewModel.Locations.Rows}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LocationRow">
                            <Grid ColumnSpacing="12" ColumnDefinitions="*,Auto,Auto"
                                  AutomationProperties.Name="{x:Bind Description, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Path}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                <ToggleSwitch Grid.Column="1" OnContent="Reference" OffContent="Search"
                                              MinWidth="0"
                                              IsOn="{x:Bind IsReference, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind SwitchName}"
                                              ToolTipService.ToolTip="A reference is searched and matched, and its copies are never marked or removed." />
                                <Button Grid.Column="2" Command="{x:Bind RemoveCommand}"
                                        AutomationProperties.Name="Remove this location">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="What makes a match" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Name" IsChecked="{x:Bind ViewModel.Filters.MatchName, Mode=TwoWay}" />
                    <CheckBox Content="Size" IsChecked="{x:Bind ViewModel.Filters.MatchSize, Mode=TwoWay}" />
                    <CheckBox Content="Last modified" IsChecked="{x:Bind ViewModel.Filters.MatchModified, Mode=TwoWay}" />
                    <CheckBox Content="Content" IsChecked="{x:Bind ViewModel.Filters.MatchContent, Mode=TwoWay}" />
                </StackPanel>

                <Grid ColumnSpacing="12" RowSpacing="8" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="Checksum" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="140"
                              ItemsSource="{x:Bind ViewModel.Filters.AlgorithmNames}"
                              SelectedIndex="{x:Bind ViewModel.Filters.AlgorithmIndex, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.Filters.MatchContent, Mode=OneWay}"
                              AutomationProperties.Name="Checksum"
                              ToolTipService.ToolTip="What a content match groups by. Every copy is compared byte for byte before it is removed, whichever this is." />

                    <TextBlock Grid.Row="1" Text="Sizes" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <NumberBox Width="96" PlaceholderText="Smallest" Minimum="0"
                                   Value="{x:Bind ViewModel.Filters.SmallestAmount, Mode=TwoWay}"
                                   AutomationProperties.Name="Smallest size" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Filters.UnitNames}"
                                  SelectedIndex="{x:Bind ViewModel.Filters.SmallestUnitIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Unit of the smallest size" />
                        <TextBlock Text="to" VerticalAlignment="Center" />
                        <NumberBox Width="96" PlaceholderText="Largest" Minimum="0"
                                   Value="{x:Bind ViewModel.Filters.LargestAmount, Mode=TwoWay}"
                                   AutomationProperties.Name="Largest size" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.Filters.UnitNames}"
                                  SelectedIndex="{x:Bind ViewModel.Filters.LargestUnitIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Unit of the largest size" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Extensions" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <ComboBox ItemsSource="{x:Bind ViewModel.Filters.ExtensionModeNames}"
                                  SelectedIndex="{x:Bind ViewModel.Filters.ExtensionModeIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Which extensions to search" />
                        <TextBox MinWidth="160" PlaceholderText="jpg, png"
                                 Text="{x:Bind ViewModel.Filters.Extensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.Filters.ReadsExtensions, Mode=OneWay}"
                                 AutomationProperties.Name="Extensions" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="Hidden files" IsChecked="{x:Bind ViewModel.Filters.SearchHidden, Mode=TwoWay}" />
                        <CheckBox Content="System files" IsChecked="{x:Bind ViewModel.Filters.SearchSystem, Mode=TwoWay}" />
                        <CheckBox Content="Program and Windows folders"
                                  IsChecked="{x:Bind ViewModel.Filters.SearchPassedOverPlaces, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Search the places passed over by default: Windows, program folders, other accounts and every Recycle Bin. A copy found there is matched, and never removed." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Your choices could not be saved, so they will not be remembered next time."
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.Filters.SaveFailed, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="6" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
            <Button Content="Search" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SearchCommand}" />
            <Button Grid.Column="1" Content="Stop" Command="{x:Bind ViewModel.StopCommand}"
                    ToolTipService.ToolTip="Stop searching. The groups already confirmed stay." />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}" />

            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3"
                         Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                         IsIndeterminate="{x:Bind ViewModel.StageProgressIsUnknown, Mode=OneWay}"
                         Value="{x:Bind ViewModel.StageProgress, Mode=OneWay}"
                         AutomationProperties.Name="Search progress" />
        </Grid>

        <!-- What the search did not look at, so a search that skipped a place never reads as one
             that found nothing there (§7.4). -->
        <Expander Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Header="{x:Bind ViewModel.NotesHeading, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}">
            <ListView MaxHeight="180" SelectionMode="None" ItemsSource="{x:Bind ViewModel.Notes}"
                      AutomationProperties.Name="Notes on what the search did not look at">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Padding="0,4" IsTextSelectionEnabled="True" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <Grid Grid.Row="4" RowSpacing="6" RowDefinitions="Auto,*">
            <TextBlock Text="{x:Bind ViewModel.SpaceNote}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />

            <!-- Groups arrive while the reader reads, each inserted where its space puts it. Keeping
                 the items in view holds the rows on screen still while one goes in above them. -->
            <ListView Grid.Row="1" SelectionMode="None"
                      AutomationProperties.Name="Duplicate groups"
                      ItemsSource="{x:Bind ViewModel.Groups}"
                      ItemTemplate="{StaticResource GroupTemplate}"
                      ItemContainerStyle="{StaticResource GroupContainer}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </Grid>
    </Grid>
</Page>
