<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels"
    xmlns:views="using:Deguffer.App.Views"
    xmlns:controls="using:Deguffer.App.Controls"
    Background="Transparent">

    <Page.Resources>
        <!-- The compact rows' figure column, one width down the whole list. See CompactFindingRow. -->
        <controls:WidthGroup x:Key="FigureWidths" />

        <!--
            The compact row: the four things the user is choosing between, on one line — is it
            ticked, what is it, what class of thing is it, and how big is it.

            A row that cannot be ticked says why, rather than leaving a greyed-out checkbox that
            states no reason (§6.5). The reason sits beside the figure rather than in place of it,
            because the two do not always arrive together: a row needing administrator rights has a
            real total and still cannot be ticked, and the list is ordered by that total, so
            replacing it left the biggest cause at the top of the list with no number against it. A
            row with nothing to reclaim drops the figure instead — it reads "0 B" or "—", which the
            reason beside it already says in words.

            The figure sits in a column of one width on every row, and everything to its right of
            the name is right-aligned against it. Each row builds its own Grid, so a figure column
            left to Auto alone comes out at a different width on every row and the chips beside it
            step raggedly down the page. The figure's cell is in a WidthGroup instead, which gives
            every row the width of the widest figure in the list: the chip's own column can stay
            Auto and still start at the same offset from the right on every row, which is what puts
            the chips in a straight line. A fixed width would cut off an estimate such as "about
            1.0 GB", and any figure under Windows text scaling.

            The chip's column is not grouped, because Windows text scaling grows the chip, and a
            fixed column would have it overflow leftwards over the status instead of pushing the
            name.

            The name never gives way. It is the row's identity, and a list of rows that no longer
            say which row they are is not a list. So the status takes the slack, which means the
            status is what trims when the window narrows, and it is a secondary sentence that the
            disclosure repeats in full. Where the name and the chips cannot share a line, the chips
            and the figure move under the name and the status trims beside it (ReflowRow). The chips
            stay in line with the rows above because they are right-aligned on either line.
        -->
        <DataTemplate x:Key="CompactFindingRow" x:DataType="vm:FindingViewModel">
            <Grid ColumnSpacing="{StaticResource ControlGap}" ColumnDefinitions="Auto,*" Padding="16,8,0,8">

                <!-- §7's sentence, announced where the decision is made. A tooltip cannot serve a
                     screen reader or a keyboard, and this is the control both of them land on to
                     tick the row, so the answer to "what happens if I tick this" is on it. -->
                <CheckBox Grid.Column="0"
                          MinWidth="0"
                          VerticalAlignment="Center"
                          IsChecked="{x:Bind SelectionState, Mode=OneWay}"
                          Command="{x:Bind ToggleCommand}"
                          IsEnabled="{x:Bind CanBeSelected, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Name}"
                          AutomationProperties.AutomationId="{x:Bind AutomationIds.Toggle}"
                          AutomationProperties.HelpText="{x:Bind Facts.WhatHappensOnNextUse}" />

                <controls:ReflowRow Grid.Column="1"
                                    ColumnSpacing="{StaticResource ControlGap}"
                                    RowSpacing="{StaticResource LabelGap}"
                                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}">
                        <!-- The same sentence for a pointer. The row has no line to write it on, so it is
                             here, on the checkbox above, and in the disclosure below — §7 asks that it be
                             reachable from the row by whatever the reader is using. -->
                        <TextBlock Text="{x:Bind Name}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind Facts.WhatHappensOnNextUse}" />

                        <!-- On the row line itself, unlike the "What is this?" link, which compact folds into
                             the disclosure. For a row whose items are chosen one by one, choosing them is
                             the decision the row is for, and a decision two levels down is one nobody
                             finds. It shows the count because that is what says whether the list is worth
                             opening. -->
                        <HyperlinkButton Content="{x:Bind ItemsLinkLabel, Mode=OneWay}"
                                         Visibility="{x:Bind OffersItems, Mode=OneWay}"
                                         Padding="{StaticResource LinkPadding}"
                                         VerticalAlignment="Center"
                                         Tag="{x:Bind}"
                                         Click="OnItemsLinkClicked"
                                         AutomationProperties.Name="{x:Bind Text.ItemsLinkName}"
                                         AutomationProperties.AutomationId="{x:Bind AutomationIds.ItemsLink}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                               Visibility="{x:Bind CannotBeSelected, Mode=OneWay}"
                               Style="{StaticResource Caption}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}">
                        <controls:ProviderChips Facts="{x:Bind Facts}" />

                        <!-- The group is on the cell rather than the figure, so a row whose figure is
                             hidden still keeps the column's width and its chip stays in line. -->
                        <Border MinWidth="72"
                                controls:WidthGroup.Group="{StaticResource FigureWidths}">
                            <TextBlock Text="{x:Bind SizeLabel, Mode=OneWay}"
                                       Visibility="{x:Bind HasSizeToShow, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ChangeTip, Mode=OneWay}"
                                       Style="{StaticResource RowFigure}"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </controls:ReflowRow>
            </Grid>
        </DataTemplate>

        <!-- One row per named cause (§7): the checkbox, the name line with the
             link to everything else at the end of it, the sentence saying what happens on next
             use, and the figures. -->
        <DataTemplate x:Key="StandardFinding" x:DataType="vm:FindingViewModel">
            <Grid RowDefinitions="Auto,Auto">

                <Grid Grid.Row="0" ColumnSpacing="12" Padding="{StaticResource CardRowPadding}" ColumnDefinitions="Auto,*,Auto">

                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Top"
                              MinWidth="0"
                              Margin="{StaticResource FirstLineOffset}"
                              IsChecked="{x:Bind SelectionState, Mode=OneWay}"
                              Command="{x:Bind ToggleCommand}"
                              IsEnabled="{x:Bind CanBeSelected, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind Name}"
                              AutomationProperties.AutomationId="{x:Bind AutomationIds.Toggle}" />

                    <StackPanel Grid.Column="1" Spacing="{StaticResource ControlGap}">

                        <!-- The name, the chips and the links on one line where they fit. Where
                             they do not, the chips and the "What is this?" link move to a line of
                             their own under the name (ReflowRow), rather than any of them giving
                             up letters: the name is what says which row this is, a half-drawn
                             link reads as a defect, and a trimmed chip can lose the word that names its tier.
                             Right-aligned on either line, so the chips form one column down the
                             list with the rows that did not wrap. -->
                        <controls:ReflowRow ColumnSpacing="{StaticResource ControlGap}"
                                            RowSpacing="{StaticResource LabelGap}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}">
                                <TextBlock Text="{x:Bind Name}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />

                                <!-- Beside the name, because for a row whose items are chosen one by one,
                                     choosing them is what the row is for. It is not beside the chip, so
                                     that the chip lands in the same place whether a row has one or not. -->
                                <HyperlinkButton Content="{x:Bind ItemsLinkLabel, Mode=OneWay}"
                                                 Visibility="{x:Bind OffersItems, Mode=OneWay}"
                                                 VerticalAlignment="Center"
                                                 Padding="{StaticResource InlineLinkPadding}"
                                                 Tag="{x:Bind}"
                                                 Click="OnItemsLinkClicked"
                                                 AutomationProperties.Name="{x:Bind Text.ItemsLinkName}"
                                                 AutomationProperties.AutomationId="{x:Bind AutomationIds.ItemsLink}" />
                            </StackPanel>

                            <!-- "What is this?" opens whose folder this is, what it is for, and the
                                 plan that says what would happen to it. One dialog holds both,
                                 because they are one question: a reader cannot judge a list of paths
                                 belonging to a tool they have never heard of. It is a link rather
                                 than a button because it opens an explanation and changes nothing.
                                 It ends the name line rather than the sentence, so the row reads as
                                 prose from the name down to the figures, and the link is at a fixed
                                 place on every row. -->
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}">
                                <controls:ProviderChips Facts="{x:Bind Facts}" />
                                <HyperlinkButton Content="What is this?"
                                                 VerticalAlignment="Center"
                                                 Padding="{StaticResource InlineLinkPadding}"
                                                 Tag="{x:Bind}"
                                                 Click="OnWhatIsThisClicked"
                                                 AutomationProperties.Name="{x:Bind Text.InformationLinkName}"
                                                 AutomationProperties.AutomationId="{x:Bind AutomationIds.InformationLink}" />
                            </StackPanel>
                        </controls:ReflowRow>

                        <TextBlock Text="{x:Bind Facts.WhatHappensOnNextUse}"
                                   Style="{StaticResource SecondaryText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="{StaticResource LabelGap}" MinWidth="104" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind SizeLabel, Mode=OneWay}"
                                   Style="{StaticResource Figure}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}"
                                   Style="{StaticResource Caption}"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right" />

                        <!-- How far the figure moved since the scan before (#358). A number against
                             a date and nothing more (§7.1): it ticks nothing and orders nothing. -->
                        <TextBlock Text="{x:Bind ChangeLabel, Mode=OneWay}"
                                   Visibility="{x:Bind HasChange, Mode=OneWay}"
                                   Style="{StaticResource Caption}"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                        <controls:FillBar Style="{StaticResource ShareBar}"
                                          Value="{x:Bind SharePercent, Mode=OneWay}"
                                          Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="16,0" />
            </Grid>
        </DataTemplate>

        <!--
            The same row with the prose folded away. The whole line is the disclosure's header, so
            the chevron lands at the end of it and the detail opens across the full card rather
            than inside one narrow column.

            Every row gets the disclosure, including a toolchain that is not installed: what it
            holds is the sentence §7 asks each row to state, which compact hides rather than
            retires, and the link to the rest. A row with nothing else to add still has both, so
            there is no such thing here as a row with an empty disclosure.
        -->
        <DataTemplate x:Key="CompactFinding" x:DataType="vm:FindingViewModel">
            <Grid RowDefinitions="Auto,Auto">
                <Expander Grid.Row="0"
                          AutomationProperties.Name="{x:Bind Text.DetailToggleName}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,0,0,8">
                    <Expander.Header>
                        <ContentPresenter Content="{x:Bind}"
                                          ContentTemplate="{StaticResource CompactFindingRow}" />
                    </Expander.Header>

                    <!-- Indented to the name above it rather than to the card edge, so the
                         disclosure reads as belonging to its row and not to the list. -->
                    <StackPanel Spacing="{StaticResource LabelGap}" Margin="72,0,16,0">
                        <TextBlock Text="{x:Bind Facts.WhatHappensOnNextUse}"
                                   Style="{StaticResource SecondaryText}" />

                        <!-- The change since the scan before, folded away here for the reason the
                             sentence above is, and on the figure's tooltip for a pointer. -->
                        <TextBlock Text="{x:Bind ChangeLabel, Mode=OneWay}"
                                   Visibility="{x:Bind HasChange, Mode=OneWay}"
                                   Style="{StaticResource SecondaryText}" />

                        <!-- Inside the disclosure rather than on the row line, which is the same
                             place §7 puts the sentence above it and for the same reason: compact
                             exists to trade prose off the line so the whole list is on screen at
                             once, and a link on every line is prose. -->
                        <HyperlinkButton Content="What is this?"
                                         Padding="{StaticResource InlineLinkPadding}"
                                         Tag="{x:Bind}"
                                         Click="OnWhatIsThisClicked"
                                         AutomationProperties.Name="{x:Bind Text.InformationLinkName}"
                                         AutomationProperties.AutomationId="{x:Bind AutomationIds.InformationLink}" />
                    </StackPanel>
                </Expander>

                <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="16,0" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Layout roots stay transparent so the §6.5 material shows through; every surface below
         sits on a Fluent layer brush and reads correctly on a flat solid background too. -->
    <Grid controls:ReadingColumn.Limit="{StaticResource ReadingWidth}" RowSpacing="{StaticResource RegionGap}" RowDefinitions="Auto,Auto,*" Padding="{StaticResource PagePadding}">

        <controls:PageHeader controls:ReadingColumn.Fills="True" Destination="Storage" />

        <!-- §7: free space, prominently. It is the only number the user came for. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="28" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="{StaticResource ControlGap}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}">
                        <TextBlock Text="{x:Bind ViewModel.FreeSpaceNowLabel, Mode=OneWay}"
                                   Style="{StaticResource HeroFigure}" />
                        <TextBlock Text="{x:Bind ViewModel.CapacityLabel}"
                                   Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Bottom"
                                   Margin="{StaticResource HeroFigureBaselineOffset}" />

                        <!-- The space the clean under way has given back, counted up as each
                             row's run finishes, beside the free space it is going into. Only
                             while a clean runs: once it ends, the card states the same figure
                             as what Deguffer removed. -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource ControlGap}"
                                    Padding="16,0,0,0"
                                    Margin="{StaticResource HeroFigureBaselineOffset}"
                                    VerticalAlignment="Bottom"
                                    Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.CleanProgress.RemovedSoFarLabel, Mode=OneWay}"
                                       Style="{StaticResource Figure}" />
                            <TextBlock Text="removed so far"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Bottom"
                                       Margin="{StaticResource FigureBaselineOffset}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- §7: free space before and after. The figure the user started from, read from
                         the volume before the run, against the one above. Its own line, so it wraps
                         rather than clips on a narrow window. -->
                    <TextBlock Text="{x:Bind ViewModel.RunResult.FreeSpaceMoveText, Mode=OneWay}"
                               Style="{StaticResource SecondaryText}"
                               Visibility="{x:Bind ViewModel.RunResult.HasFreeSpaceMove, Mode=OneWay}" />

                    <!-- How full the disk is, at a glance: 40 GB free means nothing until you
                         know whether the volume is 256 GB or 4 TB. The figures beside it say
                         the same thing in words, so nothing is lost if the bar cannot be seen.
                         During a clean it drains as the disk gives the space back. -->
                    <controls:FillBar Value="{x:Bind ViewModel.UsedPercent, Mode=OneWay}"
                                      Height="6" />

                    <!-- §7.6: a drive that is filling wants a clean, and one that is failing
                         wants a backup first, so a drive of concern is named beside its free
                         space. Only from what Health last read: nothing here asks a drive
                         anything, so the bar stays closed until Health has been opened. The
                         title states the verdict in words, so the severity colour is not
                         needed to read it (§6.5). -->
                    <InfoBar IsOpen="{x:Bind ViewModel.DriveHealth.HasConcern, Mode=OneWay}"
                             IsClosable="False"
                             Severity="{x:Bind ViewModel.DriveHealth.Severity, Mode=OneWay}"
                             Title="{x:Bind ViewModel.DriveHealth.Title, Mode=OneWay}"
                             Message="{x:Bind ViewModel.DriveHealth.Text, Mode=OneWay}"
                             AutomationProperties.Name="Drive health" />
                </StackPanel>

                <!-- §5.4: what Deguffer removed, apart from how the free space moved. See RunFiguresView. -->
                <views:RunFiguresView x:Name="RunFiguresPanel"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Result="{x:Bind ViewModel.RunResult}"
                                      Visibility="{x:Bind ViewModel.RunResult.HasRunResult, Mode=OneWay}" />

                <!-- §5.6's verdict on the run those figures describe, and under it the line each
                     location gets, for as long as they stand. See SafetyCheckView for why the info
                     bar below cannot hold them.

                     The gap above it is this element's margin rather than the grid's
                     RowSpacing, because row spacing is a property of the rows: it stands
                     whether or not anything is in them, and before the first clean of a session
                     that is empty space under the capacity bar. -->
                <StackPanel x:Name="RunVerdictPanel"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="{StaticResource RegionGapAbove}"
                            Spacing="{StaticResource ControlGap}"
                            Visibility="{x:Bind ViewModel.RunResult.HasRunResult, Mode=OneWay}">
                    <views:SafetyCheckView Report="{x:Bind ViewModel.RunResult.SafetyCheck}" />
                    <views:RunRowsView Result="{x:Bind ViewModel.RunResult}" />
                </StackPanel>

                <!-- Windows' own retrim, offered where a clean freed a lot on a thin, virtual or
                     solid-state drive, whose storage learns the space is free only when Windows
                     trims it. Its own row rather than part of the verdict above, because a restart
                     as administrator opens on this row with no clean behind it. Offered, never
                     run unasked, and each result is Windows' own answer. -->
                <StackPanel x:Name="RetrimPanel"
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="{StaticResource RegionGapAbove}"
                            Spacing="{StaticResource ControlGap}"
                            Visibility="{x:Bind ViewModel.Retrim.IsShown, Mode=OneWay}">

                    <TextBlock Text="{x:Bind ViewModel.Retrim.OfferText, Mode=OneWay}"
                               Style="{StaticResource SecondaryText}"
                               Visibility="{x:Bind ViewModel.Retrim.IsOffered, Mode=OneWay}" />

                    <Button x:Name="RetrimButton"
                            Content="{x:Bind ViewModel.Retrim.ActionLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.Retrim.RetrimCommand}"
                            Visibility="{x:Bind ViewModel.Retrim.IsOffered, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource ControlGap}"
                                Visibility="{x:Bind ViewModel.Retrim.IsRetrimming, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind ViewModel.Retrim.IsRetrimming, Mode=OneWay}"
                                      Width="16"
                                      Height="16"
                                      AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind ViewModel.Retrim.Underway, Mode=OneWay}"
                                   Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <ItemsControl x:Name="RetrimResults"
                                  ItemsSource="{x:Bind ViewModel.Retrim.Results}"
                                  AutomationProperties.LiveSetting="Polite">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource SecondaryText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The status line, the list and the bar under it. A grid of their own rather than rows of
             the page's, because the page's row spacing would stand above the status line and the bar
             even while neither is drawn, as before a scan. Each gap here is a margin of the part it
             separates, so it goes with the part. -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto">
                <!-- This line carries a failed §5.6 verification — the most safety-critical string in the
                     app. An InfoBar rather than plain text so it is distinguishable from routine progress by
                     icon and severity, not only by reading to the end of it, and so it is announced as a
                     problem rather than read out as one more line. The card above states the same sentence
                     durably and in the critical colour, and colour and weight do neither of those things,
                     which is why the failure is stated twice. A clean that verified cleanly leaves the bar
                     to the fresh preview's totals and says so in the card alone, where it survives the next
                     scan. It stands alone across the page: the controls that shape the list are on the
                     list. It sits on its own solid surface because §6.5 forbids text that needs the blur to
                     read. Closed while there is nothing to say, as before a scan, when the empty state
                     below already says what to press and that nothing is removed until asked. -->
                <InfoBar Grid.Row="0"
                         Margin="{StaticResource RegionGapBelow}"
                         IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                         IsClosable="False"
                         Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.Status, Mode=OneWay}">

                    <!-- How far through the run, under the line naming which cause is being cleaned.
                         Determinate because a clean knows its own extent before it starts, unlike a
                         scan, which keeps the ring beside Scan. Shown only while that run
                         is in flight, so nothing here is drawn against a message about anything else.

                         The percentage is written out beside it for the same reason the capacity bar
                         above carries its figures: §6.5 forbids anything that can only be read as a
                         graphic. -->
                    <InfoBar.Content>
                        <Grid Margin="0,0,16,16"
                              ColumnSpacing="12"
                              ColumnDefinitions="*,Auto"
                              Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay}">
                            <ProgressBar Grid.Column="0"
                                         Value="{x:Bind ViewModel.CleanProgress.Percent, Mode=OneWay}"
                                         Maximum="100"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Cleaning progress" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CleanProgress.PercentLabel, Mode=OneWay}"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </InfoBar.Content>
                </InfoBar>

            <!-- One row per named cause (§7), in the order chosen over them, sharing a single surface.
                 Carding every row individually produced a column of identical boxes with no sense of
                 a list; hairline separators inside one card read as one thing to scan down. -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <!-- Collapsed rather than removed while a row's items are listed, so the rows come
                         back scrolled to where the reader left them. -->
                    <Grid RowDefinitions="Auto,*" Visibility="{x:Bind ViewModel.IsShowingFindings, Mode=OneWay}">
                        <!-- The controls that shape the list, on the list: which rows it draws, how much of
                             each, and in what order, and the menu that ticks or clears them all. Not drawn
                             until a scan has produced a row, because until then none of them does anything
                             (StorageControls). Presentation only: every row is scanned, offered, ticked and
                             removed exactly as before, whatever is chosen here. -->
                        <StackPanel x:Name="ListControls"
                                    Grid.Row="0"
                                    Visibility="{x:Bind ViewModel.Controls.ListControls, Mode=OneWay}">
                            <StackPanel Margin="{StaticResource CardRowPadding}" Spacing="{StaticResource ControlGap}">
                                <controls:ReflowRow ColumnSpacing="{StaticResource RegionGap}"
                                                    RowSpacing="{StaticResource ControlGap}">
                                    <controls:FlowRow ColumnSpacing="{StaticResource RegionGap}"
                                                      RowSpacing="{StaticResource ControlGap}"
                                                      VerticalAlignment="Center">
                                        <!-- A provider whose toolchain is absent has nothing to reclaim and
                                             nothing to tick, so by default it is not drawn: it lengthens the
                                             list without adding a decision to it. -->
                                        <CheckBox x:Name="NotInstalledToggle"
                                                  Content="Show items not installed"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  Checked="OnShowNotInstalledChanged"
                                                  Unchecked="OnShowNotInstalledChanged" />

                                        <!-- The preference Settings sets as well, read and written here
                                             through the same one. See AlreadyClearSwitch. -->
                                        <CheckBox x:Name="AlreadyClearToggle"
                                                  Content="Show items that are already clear"
                                                  MinWidth="0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{x:Bind AlreadyClear.IsOn, Mode=TwoWay}" />
                                    </controls:FlowRow>

                                    <controls:FlowRow ColumnSpacing="{StaticResource RegionGap}"
                                                      RowSpacing="{StaticResource ControlGap}"
                                                      VerticalAlignment="Center">
                                        <!-- How much of each row to draw: what differs is how much of the row
                                             is on screen and how much is one click inside it. The label is raw
                                             for assistive technology: the combo box carries the same name,
                                             and without this a screen reader announces "View" twice. -->
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}">
                                            <TextBlock Text="View"
                                                       Style="{StaticResource FieldLabel}"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                            <ComboBox x:Name="ViewSelector"
                                                      MinWidth="132"
                                                      SelectionChanged="OnViewSelectionChanged"
                                                      AutomationProperties.Name="View">
                                                <ComboBoxItem Content="Standard" />
                                                <ComboBoxItem Content="Compact" />
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- §7 lists the rows largest first, and that stays the default. A
                                             reader looking for one location by name, or taking the tiers one
                                             at a time, can reorder them here. The label is raw for the reason
                                             the View label is. -->
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}">
                                            <TextBlock Text="Sort by"
                                                       Style="{StaticResource FieldLabel}"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                            <ComboBox x:Name="OrderSelector"
                                                      MinWidth="132"
                                                      SelectionChanged="OnOrderSelectionChanged"
                                                      AutomationProperties.Name="Sort by">
                                                <ComboBoxItem Content="Size" />
                                                <ComboBoxItem Content="Name" />
                                                <ComboBoxItem Content="Safety tier" />
                                            </ComboBox>
                                            <views:StorageSelectionMenu Selection="{x:Bind ViewModel.Selection}" />
                                        </StackPanel>
                                    </controls:FlowRow>
                                </controls:ReflowRow>

                                <!-- The box goes back when its write is refused, and this says why. -->
                                <InfoBar IsOpen="{x:Bind AlreadyClear.Save.Failed, Mode=OneWay}"
                                         IsClosable="False"
                                         Severity="Warning"
                                         Title="{x:Bind vm:SettingSave.NoticeTitle}"
                                         Message="{x:Bind vm:SettingSave.NoticeMessage}" />
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="16,0" />
                        </StackPanel>

                        <!-- The template is set from the stored preference in code-behind. The shipped
                             default is named here as well, so the list is never left untemplated
                             whatever order the framework loads and shows this page in, and so the
                             markup does not disagree with what most windows will draw.

                             A list view rather than a plain items control, for the motion every other
                             list here has: a row arriving fades and slides in, and one leaving fades out
                             as the rows below close up. Nothing on a row is chosen by selecting it, so
                             selection is off, and its own controls are the tab stops rather than the
                             row's container. The rows waiting for a source folder are folded into a
                             group of their own at its foot. -->
                        <ListView x:Name="FindingsList"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Listed}"
                                  ItemTemplate="{StaticResource StandardFinding}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ItemContainerStyle="{StaticResource FindingRowContainer}"
                                  TabNavigation="Local"
                                  Padding="0,4">
                            <ListView.Resources>
                                <views:RowDisclosures />
                            </ListView.Resources>
                            <ListView.Footer>
                                <views:AwaitingFolderGroup x:Name="AwaitingGroup" Group="{x:Bind ViewModel.AwaitingFolders}" AddCommand="{x:Bind ViewModel.AddSourceFolderCommand}" />
                            </ListView.Footer>
                        </ListView>

                        <!-- Says what to do next rather than leaving a blank card that reads as a failed
                             screen, and before any scan holds the one thing to do. After the list, so it is
                             drawn over it: an empty list still takes every click on its area. -->
                        <controls:EmptyState Grid.Row="1"
                                             Glyph="&#xE721;"
                                             Title="{x:Bind ViewModel.EmptyState.Title, Mode=OneWay}"
                                             Message="{x:Bind ViewModel.EmptyState.Message, Mode=OneWay}"
                                             Visibility="{x:Bind ViewModel.EmptyState.IsShown, Mode=OneWay}">
                            <controls:EmptyState.PrimaryAction>
                                <views:StorageScanButtons x:Name="EmptyScanButtons"
                                                          ViewModel="{x:Bind ViewModel}"
                                                          ChoicePlacement="BottomEdgeAlignedLeft"
                                                          Visibility="{x:Bind ViewModel.Controls.EmptyStateOffersScan, Mode=OneWay}" />
                            </controls:EmptyState.PrimaryAction>
                        </controls:EmptyState>
                    </Grid>

                    <!-- One row's items, in place of the rows. Filled from code-behind with a list built
                         for that row; see CleanPage.ShowItemsOrRows. -->
                    <ContentControl x:Name="ItemsHost"
                                    Visibility="{x:Bind ViewModel.IsShowingItems, Mode=OneWay}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    IsTabStop="False" />
                </Grid>
            </Border>

            <!-- §7: the bar runs in the order of the flow. Scan, the primary action, comes first, and it
                 scans and removes nothing. Deleting is a separate, deliberate second step at the far end,
                 with what follows it, so Scan carries the accent and Clean does not. Clean states what the
                 ticked steps would give back, so the amount and the press that authorises it read as one.

                 On a window too narrow for one line, the choice of what follows a clean and Clean move to
                 a line of their own, right-aligned as they were (ReflowRow). Nothing the reader needs to
                 start a scan or a clean is drawn off the edge. -->
            <controls:ReflowRow Grid.Row="2"
                                ColumnSpacing="{StaticResource RegionGap}"
                                RowSpacing="{StaticResource ControlGap}"
                                Margin="{StaticResource RegionGapAbove}"
                                Visibility="{x:Bind ViewModel.Controls.ActionBar, Mode=OneWay}">

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlGap}" VerticalAlignment="Center">
                    <!-- Drawn here once a scan has produced a row, and while the first one runs, because
                         Cancel takes Scan's place. Until then the empty card holds them. -->
                    <views:StorageScanButtons x:Name="BarScanButtons"
                                              ViewModel="{x:Bind ViewModel}"
                                              ChoicePlacement="TopEdgeAlignedLeft" />

                    <!-- Last, so its space, kept while it is idle, moves nothing when it spins. -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Width="18" Height="18" VerticalAlignment="Center" />
                </StackPanel>

                <controls:FlowRow ColumnSpacing="{StaticResource ControlGap}" RowSpacing="{StaticResource ControlGap}" VerticalAlignment="Center">
                    <!-- Beside Clean, because it is part of starting one: what Deguffer does once the clean
                         it is about to start has finished. Read when the clean ends, so it can be changed
                         while one runs. -->
                    <TextBlock x:Name="WhenCompleteLabel"
                               Text="When complete"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" />
                    <ComboBox MinWidth="140"
                              VerticalAlignment="Center"
                              ItemsSource="{x:Bind ViewModel.WhenComplete.Labels}"
                              SelectedIndex="{x:Bind ViewModel.WhenComplete.SelectedIndex, Mode=TwoWay}"
                              AutomationProperties.AutomationId="WhenCompleteSelector"
                              AutomationProperties.LabeledBy="{x:Bind WhenCompleteLabel}"
                              AutomationProperties.HelpText="{x:Bind ViewModel.WhenComplete.Explanation}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.WhenComplete.Explanation}" />
                    <Button Content="{x:Bind ViewModel.Selection.CleanLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CleanCommand}"
                            AutomationProperties.AutomationId="CleanButton" />
                </controls:FlowRow>
            </controls:ReflowRow>
        </Grid>
    </Grid>
</Page>
