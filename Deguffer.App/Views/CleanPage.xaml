<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="Deguffer.App.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <!--
            The per-row disclosure, stripped back to a line of text and a chevron. In its default
            form the Expander is a filled, bordered box with a 64px header, which made the least
            important thing in each row the loudest thing on the screen. These are the standard
            Expander theme resources, overridden here so every disclosure on the page is quiet
            without restyling the control.
        -->
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
        <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
        <Thickness x:Key="ExpanderHeaderPadding">0,0,8,0</Thickness>
        <Thickness x:Key="ExpanderContentPadding">0,4,0,4</Thickness>
        <x:Double x:Key="ExpanderMinHeight">32</x:Double>

        <!--
            The compact row: the four things the user is choosing between, on one line — is it
            ticked, what is it, what class of thing is it, and how big is it.

            A row that cannot be ticked says why, rather than leaving a greyed-out checkbox that
            states no reason (§6.5). The reason sits beside the figure rather than in place of it,
            because the two do not always arrive together: a row needing administrator rights has a
            real total and still cannot be ticked, and the list is ordered by that total, so
            replacing it left the biggest cause at the top of the list with no number against it. A
            row with nothing to reclaim drops the figure instead — it reads "0 B" or "—", which the
            reason beside it already says in words.

            The figure sits in a fixed-width column and everything to its right of the name is
            right-aligned against it. WinUI 3 has no SharedSizeGroup and each row builds its own
            Grid, so a figure column left to Auto comes out at a different width on every row and
            the chips beside it step raggedly down the page. Pinning that one column is enough:
            the chip's own column can stay Auto and still start at the same offset from the right
            on every row, which is what puts the chips in a straight line.

            Only that one column is pinned, because a pinned column is a promise about text the
            app does not control. Windows text scaling grows the chip, and a fixed column would
            have it overflow leftwards over the status instead of pushing the name.

            The name never gives way. It is the row's identity, and a list of rows that no longer
            say which row they are is not a list. So the name column is Auto and the status column
            takes the slack, which means the status is what trims when the window narrows — and the
            status is a secondary sentence that the disclosure repeats in full. The window's own
            minimum width is set so that even that trim is shallow.
        -->
        <DataTemplate x:Key="CompactFindingRow" x:DataType="vm:FindingViewModel">
            <Grid ColumnSpacing="10" ColumnDefinitions="Auto,Auto,*,Auto,72" Padding="16,8,0,8">

                <!-- §7's sentence, announced where the decision is made. A tooltip cannot serve a
                     screen reader or a keyboard, and this is the control both of them land on to
                     tick the row, so the answer to "what happens if I tick this" is on it. -->
                <CheckBox Grid.Column="0"
                          MinWidth="0"
                          VerticalAlignment="Center"
                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          IsEnabled="{x:Bind CanBeSelected}"
                          AutomationProperties.Name="{x:Bind Name}"
                          AutomationProperties.HelpText="{x:Bind WhatHappensOnNextUse}" />

                <!-- The same sentence for a pointer. The row has no line to write it on, so it is
                     here, on the checkbox above, and in the disclosure below — §7 asks that it be
                     reachable from the row by whatever the reader is using. -->
                <TextBlock Grid.Column="1"
                           Text="{x:Bind Name}"
                           Style="{StaticResource SectionHeading}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind WhatHappensOnNextUse}" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind StatusLabel}"
                           Visibility="{x:Bind CannotBeSelected}"
                           Style="{StaticResource SecondaryText}"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />

                <!-- Tier is text on a tinted chip, never colour alone: the classification must
                     survive a flat background and a high-contrast theme (§6.5).

                     Two words name the tier and do not explain it, so the explanation the About
                     page gives is on the chip itself. The chip is not a tab stop, so a tooltip
                     alone would leave a screen reader with the two words: the same sentence is
                     its help text. -->
                <ContentControl Grid.Column="3"
                                HorizontalAlignment="Right"
                                Content="{x:Bind TierLabel}"
                                Style="{x:Bind Tier, Converter={StaticResource TierChipStyle}}"
                                ToolTipService.ToolTip="{x:Bind TierExplanation}"
                                AutomationProperties.Name="{x:Bind TierLabel}"
                                AutomationProperties.HelpText="{x:Bind TierExplanation}" />

                <TextBlock Grid.Column="4"
                           Text="{x:Bind SizeLabel}"
                           Visibility="{x:Bind HasSizeToShow}"
                           Style="{StaticResource Figure}"
                           FontSize="15"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- One row per named cause (§7), largest first: the checkbox, the sentence saying what
             happens on next use, the figures, and the link to everything else. -->
        <DataTemplate x:Key="StandardFinding" x:DataType="vm:FindingViewModel">
            <Grid RowDefinitions="Auto,Auto" Visibility="{x:Bind IsListed, Mode=OneWay}">

                <Grid Grid.Row="0" ColumnSpacing="14" Padding="16,14" ColumnDefinitions="Auto,*,Auto">

                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Top"
                              MinWidth="0"
                              Margin="0,2,0,0"
                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                              IsEnabled="{x:Bind CanBeSelected}"
                              AutomationProperties.Name="{x:Bind Name}" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource SectionHeading}"
                                       FontSize="15"
                                       VerticalAlignment="Center" />

                            <!-- Tier is text on a tinted chip, never colour alone:
                                 the classification must survive a flat background
                                 and a high-contrast theme (§6.5). The chip carries
                                 the tier's own explanation, by pointer and by help
                                 text, because two words name it without saying what
                                 it means. -->
                            <ContentControl Content="{x:Bind TierLabel}"
                                            Style="{x:Bind Tier, Converter={StaticResource TierChipStyle}}"
                                            ToolTipService.ToolTip="{x:Bind TierExplanation}"
                                            AutomationProperties.Name="{x:Bind TierLabel}"
                                            AutomationProperties.HelpText="{x:Bind TierExplanation}" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind WhatHappensOnNextUse}"
                                   Style="{StaticResource SecondaryText}"
                                   FontSize="13" />

                        <!-- Whose folder this is, what it is for, and the plan that says what
                             would happen to it. One dialog holds both, because they are one
                             question — a reader cannot judge a list of paths belonging to a tool
                             they have never heard of. It is a link rather than a button because it
                             opens an explanation and changes nothing. -->
                        <HyperlinkButton Content="What is this?"
                                         Margin="0,-2,0,0"
                                         Padding="0,2"
                                         Tag="{x:Bind}"
                                         Click="OnWhatIsThisClicked"
                                         AutomationProperties.Name="{x:Bind InformationLinkName}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="3" MinWidth="104" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind SizeLabel}"
                                   Style="{StaticResource Figure}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind StatusLabel}"
                                   Style="{StaticResource SecondaryText}"
                                   FontSize="11"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                        <ProgressBar Style="{StaticResource ShareBar}"
                                     Value="{x:Bind SharePercent, Mode=OneWay}"
                                     Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="16,0" />
            </Grid>
        </DataTemplate>

        <!--
            The same row with the prose folded away. The whole line is the disclosure's header, so
            the chevron lands at the end of it and the detail opens across the full card rather
            than inside one narrow column.

            Every row gets the disclosure, including a toolchain that is not installed: what it
            holds is the sentence §7 asks each row to state, which compact hides rather than
            retires, and the link to the rest. A row with nothing else to add still has both, so
            there is no such thing here as a row with an empty disclosure.
        -->
        <DataTemplate x:Key="CompactFinding" x:DataType="vm:FindingViewModel">
            <Grid RowDefinitions="Auto,Auto" Visibility="{x:Bind IsListed, Mode=OneWay}">
                <Expander Grid.Row="0"
                          AutomationProperties.Name="{x:Bind DetailToggleName}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0,0,0,6">
                    <Expander.Header>
                        <ContentPresenter Content="{x:Bind}"
                                          ContentTemplate="{StaticResource CompactFindingRow}" />
                    </Expander.Header>

                    <!-- Indented to the name above it rather than to the card edge, so the
                         disclosure reads as belonging to its row and not to the list. -->
                    <StackPanel Spacing="2" Margin="72,0,16,0">
                        <TextBlock Text="{x:Bind WhatHappensOnNextUse}"
                                   Style="{StaticResource SecondaryText}"
                                   FontSize="13" />

                        <!-- Inside the disclosure rather than on the row line, which is the same
                             place §7 puts the sentence above it and for the same reason: compact
                             exists to trade prose off the line so the whole list is on screen at
                             once, and a link on every line is prose. -->
                        <HyperlinkButton Content="What is this?"
                                         Padding="0,2"
                                         Tag="{x:Bind}"
                                         Click="OnWhatIsThisClicked"
                                         AutomationProperties.Name="{x:Bind InformationLinkName}" />
                    </StackPanel>
                </Expander>

                <Border Grid.Row="1" Style="{StaticResource Divider}" Margin="16,0" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Layout roots stay transparent so the §6.5 material shows through; every surface below
         sits on a Fluent layer brush and reads correctly on a flat solid background too. -->
    <Grid RowSpacing="16" RowDefinitions="Auto,Auto,*,Auto" Padding="28,8,28,0">

        <StackPanel Grid.Row="0" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Storage" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />

                <!-- How much of each row to draw. It sits with the list it reshapes rather than in
                     Settings, because it is a way of reading this screen and gets changed while
                     reading it. Presentation only: every row is offered in both views, ticks the
                     same checkbox and removes the same thing. What differs is how much of the row
                     is on screen and how much is one click inside it. -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <!-- A provider whose toolchain is absent has nothing to reclaim and nothing to
                         tick, so by default it is not drawn: it lengthens the list without adding a
                         decision to it. The rows still exist and are still scanned, so this only
                         decides whether they are on screen. -->
                    <CheckBox x:Name="NotInstalledToggle"
                              Content="Show items not installed"
                              MinWidth="0"
                              VerticalAlignment="Center"
                              Checked="OnShowNotInstalledChanged"
                              Unchecked="OnShowNotInstalledChanged" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Raw for assistive technology: the combo box carries the same name, and
                             without this a screen reader announces "View" twice. -->
                        <TextBlock Text="View"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <ComboBox x:Name="ViewSelector"
                                  MinWidth="132"
                                  SelectionChanged="OnViewSelectionChanged"
                                  AutomationProperties.Name="View">
                            <ComboBoxItem Content="Standard" />
                            <ComboBoxItem Content="Compact" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- §7: free space, prominently. It is the only number the user came for. -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="28" ColumnDefinitions="*,Auto">

                    <StackPanel Grid.Column="0" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.FreeSpaceNowLabel, Mode=OneWay}"
                                       Style="{StaticResource HeroFigure}" />
                            <TextBlock Text="{x:Bind ViewModel.CapacityLabel}"
                                       Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,7" />
                        </StackPanel>

                        <!-- How full the disk is, at a glance: 40 GB free means nothing until you
                             know whether the volume is 256 GB or 4 TB. The figures beside it say
                             the same thing in words, so nothing is lost if the bar cannot be seen. -->
                        <ProgressBar Value="{x:Bind ViewModel.UsedPercent, Mode=OneWay}"
                                     Maximum="100"
                                     Height="6"
                                     CornerRadius="3"
                                     IsTabStop="False"
                                     AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>

                    <!-- §5.4: the two numbers are reported separately and labelled distinctly. They
                         disagree whenever anything else on the machine writes during the run, and
                         merging them into one figure is how a user stops trusting the tool. -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="28"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasRunResult, Mode=OneWay}">
                        <Border Width="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                VerticalAlignment="Stretch" />

                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Removed by Deguffer" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.RemovedLabel, Mode=OneWay}"
                                       Style="{StaticResource Figure}" />
                        </StackPanel>

                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Free space change" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{x:Bind ViewModel.FreeSpaceChangeLabel, Mode=OneWay}"
                                       Style="{StaticResource Figure}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- This line carries the §5.6 verification headline — the most safety-critical string in
             the app. An InfoBar rather than plain text so a failed verification is distinguishable
             from routine progress by icon and severity, not only by reading to the end of it. It
             sits on its own solid surface because §6.5 forbids text that needs the blur to read. -->
        <InfoBar Grid.Row="1"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Status, Mode=OneWay}">

            <!-- How far through the run, under the line naming which cause is being cleaned.
                 Determinate because a clean knows its own extent before it starts, unlike a
                 scan, which keeps the ring beside the Selected figure. Shown only while that run
                 is in flight, so nothing here is drawn against a message about anything else.

                 The percentage is written out beside it for the same reason the capacity bar
                 above carries its figures: §6.5 forbids anything that can only be read as a
                 graphic. -->
            <InfoBar.Content>
                <Grid Margin="0,0,16,16"
                      ColumnSpacing="12"
                      ColumnDefinitions="*,Auto"
                      Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay}">
                    <ProgressBar Grid.Column="0"
                                 Value="{x:Bind ViewModel.CleanPercent, Mode=OneWay}"
                                 Maximum="100"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Cleaning progress" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.CleanPercentLabel, Mode=OneWay}"
                               Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </InfoBar.Content>
        </InfoBar>

        <!-- One row per named cause (§7), largest first, sharing a single surface. Carding every
             row individually produced a column of identical boxes with no sense of a list;
             hairline separators inside one card read as one thing to scan down. -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <!-- Says what to do next rather than leaving a blank card that reads as a screen
                     which has already failed. -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="6"
                            Padding="40"
                            Visibility="{x:Bind ViewModel.HasNoFindings, Mode=OneWay}">
                    <TextBlock Text="Nothing scanned yet"
                               Style="{StaticResource SectionHeading}"
                               FontSize="15"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource SecondaryText}"
                               FontSize="13"
                               TextAlignment="Center"
                               MaxWidth="380"
                               Text="Preview looks at the locations Deguffer recognises and reports what each one holds. It reads only — nothing is removed until you choose to." />
                </StackPanel>

                <ScrollViewer Padding="0,4">
                    <!-- The template is set from the stored preference in code-behind. The
                         shipped default is named here as well, so the list is never left
                         untemplated whatever order the framework loads and shows this page in,
                         and so the markup does not disagree with what most windows will draw. -->
                    <ItemsControl x:Name="FindingsList"
                                  ItemsSource="{x:Bind ViewModel.Findings}"
                                  ItemTemplate="{StaticResource CompactFinding}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- §7: the primary button previews. Deleting is a separate, deliberate second step, so
             Preview carries the accent and Clean does not. -->
        <Grid Grid.Row="3" ColumnSpacing="12" Padding="0,4,0,20" ColumnDefinitions="Auto,*,Auto">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="18" Height="18" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Selected" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedTotalLabel, Mode=OneWay}"
                               Style="{StaticResource Figure}"
                               FontSize="16" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- §5.5's fallback note diagnoses a slow scan; this is the remedy beside it.
                     Hidden entirely when elevating would not help, so it never offers
                     administrator rights for a problem they cannot fix. -->
                <Button Content="Elevate and rescan"
                        Visibility="{x:Bind ViewModel.CanElevate, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ElevateAndRescanCommand}"
                        AutomationProperties.HelpText="Restart Deguffer as administrator and scan again, so it can read the volume's file table and carry out steps only an administrator may perform." />
                <Button Content="Cancel"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CancelCommand}" />
                <Button Content="Clean"
                        Command="{x:Bind ViewModel.CleanCommand}" />
                <Button Content="Preview"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.PreviewCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
