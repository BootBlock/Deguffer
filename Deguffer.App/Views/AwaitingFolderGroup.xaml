<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The Storage rows waiting for a source folder, folded into one group below the list. Closed by
    default: every one of them says the same thing, and among the rows that report something they
    would bury them. The closed group still says how many it holds and what to do, so the answer
    stays on screen as one line. The rows inside are the list's own rows, drawn with its template
    and its container, so opening the group shows exactly what the list would have.

    The group's line is drawn as a compact row's is: inset 16 epx, so the title lines up with the
    checkboxes above it, and ended by a chevron of its own in the column the rows' chevrons sit in.
    The chevron is a button beside the line's Add button, never an Expander header around it, which
    would put a button inside a button (WCAG 4.1.2). See DisclosureButton.
-->
<UserControl
    x:Class="Deguffer.App.Views.AwaitingFolderGroup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    IsTabStop="False">

    <Grid RowDefinitions="Auto,Auto" Visibility="{x:Bind Group.HasRows, Mode=OneWay}">
        <!-- The button is on the group's line, so the one thing every row in the group asks for can
             be done with the group closed. One button for the group rather than one on each row:
             every provider in it reads the same approved folders, so one folder answers them all,
             and the button adds it from the page where its figures arrive. Beside the chevron as a
             Windows settings card puts its control, and the summary wraps rather than giving it up. -->
        <Grid Padding="16,12,8,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource ControlGap}">
            <StackPanel Spacing="{StaticResource LabelGap}" VerticalAlignment="Center">
                <TextBlock Text="Waiting for a source folder"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind Group.Summary, Mode=OneWay}"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Add source folder…"
                    VerticalAlignment="Center"
                    Command="{x:Bind AddCommand, Mode=OneWay}"
                    AutomationProperties.Name="Add source folder"
                    AutomationProperties.AutomationId="AwaitingFolderGroupAdd" />
            <controls:DisclosureButton x:Name="Disclosure"
                                       Grid.Column="2"
                                       Style="{StaticResource SubtleButtonStyle}"
                                       VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Waiting for a source folder"
                                       AutomationProperties.Name="Waiting for a source folder"
                                       AutomationProperties.HelpText="{x:Bind Group.Summary, Mode=OneWay}"
                                       AutomationProperties.AutomationId="AwaitingFolderGroupDisclosure" />
        </Grid>

        <!-- Sized to its rows rather than scrolled: the list it sits in does the scrolling, and a
             list inside a list that scrolls on its own traps the mouse wheel. -->
        <ListView x:Name="RowsList"
                  Grid.Row="1"
                  Visibility="{x:Bind Disclosure.IsExpanded, Mode=OneWay}"
                  ItemsSource="{x:Bind Group.Rows, Mode=OneWay}"
                  ItemContainerStyle="{StaticResource FindingRowContainer}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  TabNavigation="Local"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  AutomationProperties.Name="Locations waiting for a source folder" />
    </Grid>
</UserControl>
