<?xml version="1.0" encoding="utf-8"?>
<!--
    The network browser the Path… box opens from its chevron: a tree of the places this account uses
    or can see, listed one level at a time. Choosing a place fills the box and runs the box's own
    check, so nothing here points the page anywhere by itself.
-->
<ContentDialog
    x:Class="Deguffer.App.Views.NetworkBrowserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Deguffer.App.ViewModels"
    Title="Browse the network"
    PrimaryButtonText="Use this location"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind Browser.CanUse, Mode=OneWay}"
    Opened="OnOpened"
    Closing="OnClosing">

    <ContentDialog.Resources>
        <!-- The default dialog is too narrow for a share's path beside its tree. -->
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnAddInvoked" />
    </ContentDialog.KeyboardAccelerators>

    <Grid Width="680" Height="500" RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- A computer discovery cannot find is reached by its name: added here, kept in the
             settings, and listed under Computers you added. -->
        <Grid ColumnSpacing="8" ColumnDefinitions="*,Auto">
            <TextBox x:Name="ComputerBox"
                     Header="Add a computer by name or address (Ctrl+L)"
                     PlaceholderText="nas, nas.local or 192.0.2.10"
                     Text="{x:Bind Browser.ComputerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnComputerKeyDown"
                     IsSpellCheckEnabled="False"
                     AutomationProperties.Name="Computer name or address to add" />

            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Content="Add"
                    Command="{x:Bind Browser.AddComputerCommand}"
                    AutomationProperties.Name="Add this computer to the tree" />
        </Grid>

        <!-- Live, so a screen reader hears why the computer was not added without leaving the box. -->
        <TextBlock Grid.Row="1"
                   Text="{x:Bind Browser.ComputerRefusal, Mode=OneWay}"
                   Visibility="{x:Bind Browser.HasComputerRefusal, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   AutomationProperties.LiveSetting="Assertive" />

        <Grid Grid.Row="2" ColumnSpacing="8" ColumnDefinitions="*,Auto">
            <TextBox PlaceholderText="Filter the places listed"
                     Text="{x:Bind Browser.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsSpellCheckEnabled="False"
                     AutomationProperties.Name="Filter the places listed by name" />

            <Button Grid.Column="1"
                    Command="{x:Bind Browser.RefreshCommand}"
                    ToolTipService.ToolTip="Refresh the whole tree"
                    AutomationProperties.Name="Refresh the whole tree">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <TreeView x:Name="Tree"
                  Grid.Row="3"
                  ItemsSource="{x:Bind Browser.Roots}"
                  SelectionMode="Single"
                  SelectionChanged="OnTreeSelectionChanged"
                  CanDragItems="False"
                  CanReorderItems="False"
                  AllowDrop="False"
                  DoubleTapped="OnTreeDoubleTapped"
                  PreviewKeyDown="OnTreePreviewKeyDown"
                  AutomationProperties.Name="Network locations">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:NetworkNodeRow">
                    <TreeViewItem ItemsSource="{x:Bind Children}"
                                  IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                  HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind Spoken}">
                        <Grid ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto,Auto" Padding="0,4">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <!-- Text from another computer, shown as text and nothing else. -->
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />

                                <!-- The node's own line, so one computer that fails says so where it
                                     is and leaves the rest of the tree as it was. -->
                                <TextBlock Text="{x:Bind FailureText, Mode=OneWay}"
                                           Visibility="{x:Bind HasFailure, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>

                            <ProgressRing Grid.Column="2"
                                          Width="16"
                                          Height="16"
                                          IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                          AutomationProperties.Name="Listing" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                <!-- The Windows credentials prompt asks for the password, so
                                     Deguffer never sees or stores it. -->
                                <HyperlinkButton Content="Sign in…"
                                                 Padding="4,0"
                                                 Visibility="{x:Bind CanSignIn, Mode=OneWay}"
                                                 Click="OnSignIn"
                                                 AutomationProperties.Name="Sign in through the Windows credentials prompt" />

                                <Button Padding="6,4"
                                        Visibility="{x:Bind IsRemovable}"
                                        Click="OnRemoveComputer"
                                        ToolTipService.ToolTip="Remove this computer from the tree"
                                        AutomationProperties.Name="Remove this computer from the tree">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Read-only rather than a label, so the path can be selected and copied. -->
        <TextBox Grid.Row="4"
                 Header="Location"
                 IsReadOnly="True"
                 Text="{x:Bind Browser.SelectedPath, Mode=OneWay}"
                 AutomationProperties.Name="Selected location" />
    </Grid>
</ContentDialog>
