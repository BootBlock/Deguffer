<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="Deguffer.App.Views.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:views="using:Deguffer.App.Views"
    xmlns:viewModels="using:Deguffer.App.ViewModels">

    <!-- Every switch a row holds puts its On or Off text before the switch, so the switch ends at
         the card's padding where a combo box or a number box ends. -->
    <UserControl.Resources>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource SettingsToggleSwitchStyle}" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}" Padding="{StaticResource CardRowPadding}">
        <Grid ColumnSpacing="16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">

            <FontIcon Grid.Column="0"
                      Glyph="{x:Bind Glyph, Mode=OneWay}"
                      FontSize="{StaticResource GlyphSizeLarge}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Spacing="{StaticResource LabelGap}" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           Style="{StaticResource Caption}" />

                <!-- The shipped value, so a reader can tell whether they are on it, and the way back to it
                     while they are not. The line is as tall as the link whether or not the link is drawn,
                     so the row does not grow under the pointer when its value first moves off the default. -->
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource ControlGap}"
                            MinHeight="24"
                            Visibility="{x:Bind views:SettingsRow.IsStated(Default), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Default.Statement, Mode=OneWay}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                    <HyperlinkButton Content="Reset"
                                     Padding="{StaticResource InlineLinkPadding}"
                                     VerticalAlignment="Center"
                                     Visibility="{x:Bind Default.CanReset, Mode=OneWay}"
                                     Click="OnResetClicked"
                                     AutomationProperties.Name="{x:Bind views:SettingsRow.ResetName(Title), Mode=OneWay}"
                                     AutomationProperties.AutomationId="{x:Bind views:SettingsRow.ResetId(Title), Mode=OneWay}"
                                     AutomationProperties.HelpText="{x:Bind Default.Statement, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Right-aligned, so the control and its unit end at the card's padding on every row
                 whatever width the column is given. The unit follows the box as a word ("8 hours"), never a header above it, so a
                 number box centres in its row as every other control does. It takes the control's
                 own text colour, as a switch's On or Off does. -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="{StaticResource ControlGap}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <ContentPresenter Content="{x:Bind Control, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind Unit, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind views:SettingsRow.IsShown(Unit), Mode=OneWay}" />
            </StackPanel>

            <!-- On the row that made the change, beside the value that went back, rather than once at
                 the top of the page, where someone changing a value several screens down cannot see
                 it. Opened from code, which brings it into view once it has been laid out. -->
            <InfoBar x:Name="SaveNotice"
                     Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Margin="{StaticResource ControlGapAbove}"
                     IsClosable="False"
                     Severity="Warning"
                     Title="{x:Bind viewModels:SettingSave.NoticeTitle}"
                     Message="{x:Bind viewModels:SettingSave.NoticeMessage}" />

            <!-- Under the control as well as the words, so its chevron sits at the card's right edge
                 where a settings card's chevron is, and the explanation opens across the full row. -->
            <controls:ExplanationDisclosure Grid.Row="2"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Subject="{x:Bind Title, Mode=OneWay}"
                                            Text="{x:Bind Details, Mode=OneWay}"
                                            Items="{x:Bind DetailItems, Mode=OneWay}"
                                            Visibility="{x:Bind views:SettingsRow.IsShown(Details), Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
