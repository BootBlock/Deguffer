<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The overview a zoomed map shows in a corner: the whole picture, small, with a rectangle round the
    part of it on the screen. On a solid ground with the theme's own stroke, so it reads the same
    with the backdrop off and in high contrast (§6.5), and so are its buttons, which stand over the
    picture. Hidden, it leaves a button in its corner that brings it back.
-->
<UserControl
    x:Class="Deguffer.App.Controls.ExploreOverview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    VerticalAlignment="Top"
    HorizontalAlignment="Right">

    <Grid>
        <Border x:Name="Frame"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="3">
            <Grid>
                <!-- The picture and the rectangle are composition visuals hosted here, so the
                     rectangle follows the camera on the compositor. A picture, so raw to a screen
                     reader: the keys that move the camera do everything it does. -->
                <Grid x:Name="Picture"
                      Background="Transparent"
                      AutomationProperties.AccessibilityView="Raw"
                      PointerPressed="OnPicturePressed"
                      PointerMoved="OnPictureMoved"
                      PointerReleased="OnPictureReleased"
                      PointerCanceled="OnPictureLost"
                      PointerCaptureLost="OnPictureLost" />

                <Button x:Name="HideButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="2"
                        Padding="3"
                        MinWidth="0"
                        MinHeight="0"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        Click="OnHideClicked"
                        ToolTipService.ToolTip="Hide the overview"
                        AutomationProperties.Name="Hide the overview">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <Button x:Name="ShowButton"
                Visibility="Collapsed"
                Padding="6"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Click="OnShowClicked"
                ToolTipService.ToolTip="Show the overview of the whole picture"
                AutomationProperties.Name="Show the overview">
            <FontIcon Glyph="&#xE8A9;" FontSize="14" />
        </Button>
    </Grid>
</UserControl>
