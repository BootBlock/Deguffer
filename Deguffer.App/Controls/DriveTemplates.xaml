<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The drive picker's two ways of drawing a drive, for every page that offers one: Explore, which
    scans the drive chosen, and Duplicates, which adds it to the locations to search. A dictionary
    with a class behind it, because the templates are compiled bindings.
-->
<ResourceDictionary
    x:Class="Deguffer.App.Controls.DriveTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:exploring="using:Deguffer.Core.Exploring">

    <!--
        Two ways of drawing one drive. The list is where the choice is made, so it carries the
        label and the three space figures. The box states the mount point alone, at exactly the
        width it always had: the toolbar has no room to spare at the window's default size, and
        a box carrying the label pushed the scope chip's button off the end of it. See
        DriveEntryTemplates for how the two are told apart.
    -->
    <DataTemplate x:Key="DriveChosen" x:DataType="exploring:DriveEntry">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Collapsed on every ordinary volume, so it costs the toolbar nothing until
                 there is something to warn about. The sentence itself is on the status line,
                 where there is room for it. -->
            <FontIcon Glyph="&#xE7BA;"
                      FontSize="14"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind Choice.IsRefused, Mode=OneWay}"
                      AutomationProperties.AccessibilityView="Raw" />

            <!-- A drive Health found a concern with, collapsed otherwise for the same reason.
                 The list below names the drive and says what to do. -->
            <FontIcon Glyph="&#xE95E;"
                      FontSize="14"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind HasHealthConcern, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Health.Text, Mode=OneWay, FallbackValue=''}"
                      AutomationProperties.AccessibilityView="Raw" />

            <TextBlock Text="{x:Bind RootPath}" />
        </StackPanel>
    </DataTemplate>

    <!--
        The label column is a fixed width so the space figures line up down the list. Ragged
        ones are read a row at a time; a column is read at a glance.

        Each row states its own name, because a templated item is otherwise announced as its
        parts in layout order with nothing between them.
    -->
    <DataTemplate x:Key="DriveListed" x:DataType="exploring:DriveEntry">
        <StackPanel Spacing="2" AutomationProperties.Name="{x:Bind Description, Mode=OneWay}">
            <Grid ColumnSpacing="8" ColumnDefinitions="Auto,116,Auto">
                <TextBlock Grid.Column="0" Text="{x:Bind RootPath}" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind Choice.LabelText, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind Choice.Sizes, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- A refused volume is listed with the rest and says here why choosing it will
                 not scan anything, rather than disappearing from a list the user can check
                 against File Explorer (§7.1). Raw to the screen reader because the panel's
                 name already carries the same sentence for the row as a whole.

                 Below the Grid rather than spanning its columns. A spanning child wider than
                 the row hands its excess to the Auto columns in the span, which pushed this
                 one row's label and size figures out of line with every other row - the very
                 alignment the fixed label column above exists to hold. -->
            <TextBlock Text="{x:Bind Choice.Refusal, Mode=OneWay}"
                       Visibility="{x:Bind Choice.IsRefused, Mode=OneWay}"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AccessibilityView="Raw" />

            <!-- §7.6: the drive under this volume that Health last found a concern with, and what
                 to do first. Read from Health's last reading only, so a drive is never asked
                 anything for the picker. The verdict is a word, not only the icon (§6.5). Raw to
                 the screen reader because the panel's name already carries it. -->
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        MaxWidth="380"
                        Visibility="{x:Bind HasHealthConcern, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw">
                <FontIcon Glyph="&#xE95E;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock TextWrapping="Wrap" MaxWidth="360">
                    <Run Text="{x:Bind Health.Word, Mode=OneWay, FallbackValue=''}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{x:Bind Health.Text, Mode=OneWay, FallbackValue=''}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <controls:DriveEntryTemplates x:Key="DriveEntry"
                                  Chosen="{StaticResource DriveChosen}"
                                  Listed="{StaticResource DriveListed}" />
</ResourceDictionary>
