<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The banner a list or a picture shows in place of its contents: where it has one, a large quiet
    glyph; a title; where there is one, a sentence saying what to do next; and, where one press undoes
    what keeps the rows back, a button that does it. One control, so every empty state on every page
    looks the same and says why it is empty in the same place. DesignEmptyStateTests holds the pages
    to it.

    Each part takes its size from a named style in App.xaml, never a literal here, so the empty
    states keep one size per part when the type ramp moves.
-->
<UserControl
    x:Class="Deguffer.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    HorizontalAlignment="Center"
    VerticalAlignment="Top"
    MaxWidth="460"
    Margin="0,24,0,0">

    <StackPanel Spacing="12">
        <FontIcon x:Name="GlyphIcon" Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource EmptyStateGlyph}" />
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource EmptyStateTitle}" />
        <TextBlock x:Name="MessageText" Text="{x:Bind Message, Mode=OneWay}" Style="{StaticResource EmptyStateMessage}" />

        <!-- Never the accent: the page's primary action is elsewhere on it, and this only undoes a
             choice the reader made, such as a filter. -->
        <Button x:Name="ActionButton"
                HorizontalAlignment="Center"
                Content="{x:Bind ActionLabel, Mode=OneWay}"
                Command="{x:Bind ActionCommand, Mode=OneWay}" />
    </StackPanel>
</UserControl>
