<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Deguffer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deguffer.App"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:converters="using:Deguffer.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- The drive picker's two ways of drawing a drive, for Explore and Duplicates. -->
                <controls:DriveTemplates />

                <!-- The switch a settings row holds, with its On or Off text before it. -->
                <ResourceDictionary Source="ms-appx:///Controls/SettingsToggleSwitchStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The brushes of a button that restarts Deguffer as administrator: a warm, quiet tint, so
                the offer is noticed beside the plain buttons around it without reading as the page's
                primary action (the accent) or as a failure (critical red). The label says what the
                button does, so the tint only draws the eye to it (§6.5).

                Default (dark) and Light repeat their keys because ThemeDictionaries cannot share an
                entry between two themes. High Contrast takes the ordinary button's brushes, so the
                user's chosen contrast colours and borders are kept.

                The Startup page's row tints: the success and critical hues at under a tenth of their
                strength, so a column of entries that start reads apart from the disabled ones at a
                glance without drowning the text, and translucent, so the list's own pointer-over and
                selection backplates still show through. Each row's badge says the state in words, so
                the tint is never the only cue. High Contrast draws none, leaving the user's colours.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ElevateButtonBackground" Color="#3A2A1B" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPointerOver" Color="#46321E" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPressed" Color="#322519" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrush" Color="#9A5A22" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPointerOver" Color="#B86C2A" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPressed" Color="#86501F" />
                    <SolidColorBrush x:Key="StartupRowStartsBackground" Color="#186CCB5F" />
                    <SolidColorBrush x:Key="StartupRowDisabledBackground" Color="#18FF99A4" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ElevateButtonBackground" Color="#FDF1E4" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPointerOver" Color="#FBE7D1" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPressed" Color="#F7DCBE" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrush" Color="#E6A066" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPointerOver" Color="#DA8A44" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPressed" Color="#C97A36" />
                    <SolidColorBrush x:Key="StartupRowStartsBackground" Color="#140F7B0F" />
                    <SolidColorBrush x:Key="StartupRowDisabledBackground" Color="#14C42B1C" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ElevateButtonBackground" ResourceKey="ButtonBackground" />
                    <StaticResource x:Key="ElevateButtonBackgroundPointerOver" ResourceKey="ButtonBackgroundPointerOver" />
                    <StaticResource x:Key="ElevateButtonBackgroundPressed" ResourceKey="ButtonBackgroundPressed" />
                    <StaticResource x:Key="ElevateButtonBorderBrush" ResourceKey="ButtonBorderBrush" />
                    <StaticResource x:Key="ElevateButtonBorderBrushPointerOver" ResourceKey="ButtonBorderBrushPointerOver" />
                    <StaticResource x:Key="ElevateButtonBorderBrushPressed" ResourceKey="ButtonBorderBrushPressed" />
                    <SolidColorBrush x:Key="StartupRowStartsBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="StartupRowDisabledBackground" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:TierChipStyleConverter x:Key="TierChipStyle" />
            <converters:RunStatementStyleConverter x:Key="RunStatementStyle" />
            <converters:StandingChipStyleConverter x:Key="StandingChipStyle" />
            <converters:StartupChipStyleConverter x:Key="StartupChipStyle" />
            <converters:StartupRowStyleConverter x:Key="StartupRowStyle" />
            <converters:DriveVerdictChipStyleConverter x:Key="DriveVerdictChipStyle" />
            <converters:AttributeStandingChipStyleConverter x:Key="AttributeStandingChipStyle" />

            <!--
                The spacing scale: one resource per role, each a multiple of Fluent's 4 px grid, so
                edges and baselines line up from page to page and a role is changed in one place.
                Markup that sets one of these roles takes its resource, and any literal, a role's or
                a one-off's, still sits on the grid. DesignSpacingTests holds every value, here and on the pages, to the grid.

                Label gap: between a line and the line that qualifies it (a name and its path, a
                title and its description, a figure and its label). Control gap: between neighbours
                inside one region (controls in a row, rows in a stack, the columns of a row). Region
                gap: between the regions of a page or a card, such as a group of settings and the
                next; RegionGapAbove is the same gap as a margin, for a heading or card that opens a
                region inside a stack already spaced by the control gap, and the two move together.
                Card row padding is a row drawn as a card, or as the heading of one; row padding is a
                row of a list inside a card. Card bleed cancels the card padding at each side, for a
                list whose rows and their pointer-over highlight run to a card's inner edges, so the
                two move together. Page padding is the inset of every page the rail opens, and the
                page notice margin is the account notice above the pages at the same side inset, so
                its edge and the page's are one line. Page bleed undoes the page padding for
                decoration that runs to the page's edges under the padded content. Nested row indent
                sets rows that answer to the row above them, such as the values a picker governs,
                in from it, so they read as its and not as settings of their own. Expander row padding
                is a settings row's height inside an expander's header, which brings its own side inset.
                Disclosure bleed undoes the inset an Expander's header template gives its content, which
                the template reads as a static resource no local override reaches, so a quiet disclosure's
                words start on the line the text above them starts on.
            -->
            <x:Double x:Key="LabelGap">4</x:Double>
            <x:Double x:Key="ControlGap">8</x:Double>
            <x:Double x:Key="RegionGap">16</x:Double>
            <Thickness x:Key="RegionGapAbove">0,16,0,0</Thickness>
            <Thickness x:Key="ControlGapAbove">0,8,0,0</Thickness>
            <Thickness x:Key="CardPadding">20</Thickness>
            <Thickness x:Key="CardBleed">-20,0</Thickness>
            <Thickness x:Key="CardRowPadding">16,12</Thickness>
            <Thickness x:Key="RowPadding">12,8</Thickness>
            <Thickness x:Key="NestedRowIndent">32,0,0,0</Thickness>
            <Thickness x:Key="ExpanderRowPadding">0,12</Thickness>
            <Thickness x:Key="PagePadding">28,8,28,20</Thickness>
            <Thickness x:Key="PageNoticeMargin">28,8,28,0</Thickness>
            <Thickness x:Key="PageBleed">-28,0,-28,-20</Thickness>
            <Thickness x:Key="DisclosureBleed">-16,0,0,0</Thickness>

            <!--
                Reading width: the widest a page's lists, forms and the controls round them grow
                (Controls/ReadingColumn), so a row's name and its figures stay close enough on a wide
                window to read as one row. Only the page header, decoration, a scroller with a narrower
                column of its own, and a map drawing a picture run past it. Form reading
                width is narrower, for a column of settings rows that are each a title and a sentence.
            -->
            <x:Double x:Key="ReadingWidth">1200</x:Double>
            <x:Double x:Key="FormReadingWidth">720</x:Double>

            <!--
                The optical corrections, the only values off the grid, each named for the reason it
                is off it. The box each one shapes is still on the grid; the odd pixels set what is
                inside it against a glyph, a line of text or a baseline.

                ChipPadding: a Caption line is 16 px, so 2 above and below makes a 20 px chip, Fluent's
                medium badge, which sits centred in a row without setting its height.
                LinkPadding and InlineLinkPadding: 2 above and below a 20 px line of link text makes
                a 24 px target, the least WCAG 2.5.8 allows, without the row growing. A link among
                other controls has 4 at each side for its pointer-over plate; a link that starts or
                ends a line of text has none, so its words line up with the text above and below it.
                FirstLineOffset: a glyph or check box set at the top of wrapping text, moved down to
                sit level with the text's first 20 px line rather than with the top of its box.
                HeroFigureBaselineOffset and FigureBaselineOffset: lift Body text set at the foot of
                a HeroFigure or a Figure onto the figure's baseline, which the larger line's deeper
                descent puts above the foot of the box.
                ToggleSwitchAreaInset: a settings switch's pointer-over plate and focus target, inset
                5 above and below inside the 40 px the switch stands in, the SDK's own value, so the
                settings switch draws as every stock switch does.
            -->
            <Thickness x:Key="ChipPadding">8,2</Thickness>
            <Thickness x:Key="LinkPadding">4,2</Thickness>
            <Thickness x:Key="InlineLinkPadding">0,2</Thickness>
            <Thickness x:Key="FirstLineOffset">0,2,0,0</Thickness>
            <Thickness x:Key="HeroFigureBaselineOffset">0,0,0,7</Thickness>
            <Thickness x:Key="FigureBaselineOffset">0,0,0,2</Thickness>
            <Thickness x:Key="ToggleSwitchAreaInset">0,5</Thickness>

            <!--
                The shapes. Fluent has two corner radii: ControlCornerRadius (4) for a control and a
                row, and OverlayCornerRadius (8) for a card and an overlay. Every corner in the shell
                is one of those or one of the two below, so a card on one page is the shape of a card
                on the next. DesignShapeTests holds the pages to these resources.

                PillCornerRadius: a chip or a round button, at least half the height of anything that
                wears it. A radius past half a side is drawn at half the side, so one value makes a
                20 px chip and a 32 px button both pills.
                ColumnCornerRadius: a chart column, rounded at the top only, because it stands on the
                baseline under it.
                ToggleSwitchKnobCornerRadius: the knob of the settings switch only, the SDK's own value,
                so its knob is the stock switch's shape at every size it animates to.
            -->
            <CornerRadius x:Key="PillCornerRadius">16</CornerRadius>
            <CornerRadius x:Key="ColumnCornerRadius">4,4,0,0</CornerRadius>
            <CornerRadius x:Key="ToggleSwitchKnobCornerRadius">7</CornerRadius>

            <!--
                §7's "colour by tier". These are Styles rather than loose brushes so the colours
                live in XAML as ThemeResource references: each element resolves them itself and
                re-resolves on a light/dark switch, which a brush handed over from C# cannot do.
                Shared by the finding rows and the tier reference on the About page, so the two
                cannot drift apart.
            -->
            <Style x:Key="TierChipBase" TargetType="ContentControl">
                <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource ChipPadding}" />
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <!-- ContentControl's default template is bare — it presents content and draws no
                     chrome at all, so Background, CornerRadius and Padding are ignored without
                     this. The template binds them instead of baking in colours, which is what
                     keeps the tier brushes in the per-tier styles below. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <!-- The chip itself is what a screen reader reads, because that
                                     is what carries the tier's explanation as help text. The
                                     label inside it is the same words again, so it is kept out of
                                     the accessibility tree rather than announced twice — which
                                     means every chip has to set AutomationProperties.Name, or it
                                     is announced with no name at all. -->
                                <ContentPresenter AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TierChipRegenerableCache" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>

            <Style x:Key="TierChipRegenerableWithCost" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="TierChipUserData" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="TierChipDoNotTouch" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- An installed app's standing, on the tier chip's shape. Neutral, because a standing is
                 a finding rather than a warning, except where nothing could prove it either way. -->
            <Style x:Key="StandingChip" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A researched provider's chip (ProviderBasis). Neutral, because it qualifies the row
                 rather than warning about it, and caution's amber is Tier 2's. -->
            <Style x:Key="BasisChip" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="StandingChipUnproven" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <!--
                §6.5: colours come from theme brushes so they stay legible over unpredictable
                desktop content, in light and dark, and with the backdrop absent entirely.
            -->
            <!-- A Startup row's tint by whether the entry starts (StartupRowStyleConverter). Styles, as the
                 chips are, so each row re-resolves its brush on a light or dark switch. -->
            <Style x:Key="StartupRowStarts" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource StartupRowStartsBackground}" />
            </Style>

            <Style x:Key="StartupRowDisabled" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource StartupRowDisabledBackground}" />
            </Style>

            <Style x:Key="StartupRowUnknown" TargetType="Grid">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!--
                The card styles, the only places a card's fill and stroke are named, so every card is
                drawn the same way and a page cannot drift into a fill or a radius of its own
                (DesignShapeTests).

                One card per region, not one per row. Giving the free-space figure, the status
                line, every finding and the buttons an identical border made nothing more
                important than anything else, so the eye had no entry point. Weight now comes from
                type size and spacing; the card is only the surface holding a region together.
            -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <!-- A card standing over a picture of its own, such as About's starfield, takes a solid
                 fill rather than the translucent layer fill: a star behind a line of text would show
                 through the layer, and the text is what the card is for (§6.5). The tertiary solid
                 fill is the colour the layer fill comes to over the window's own. -->
            <Style x:Key="SolidCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            </Style>

            <!-- One piece of a card drawn as a run of list rows. The fill and stroke are the card's;
                 which edges, corners and padding a piece takes are bound from CardRows. -->
            <Style x:Key="CardRowStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- A row of a list that stands on its own, such as a folder Settings is told about: a
                 control's radius and the card fill, which reads as a row against the layer under it. -->
            <Style x:Key="ListCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource RowPadding}" />
            </Style>

            <!-- A panel floating over a map. Solid, because a tint over a treemap's colours is not a
                 surface anybody can read. -->
            <Style x:Key="OverlayCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>

            <!-- A button floating over a map, framed as an overlay card is, for the same reason. -->
            <Style x:Key="OverlayButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- A window's command strip along its foot, divided from the content above it by the
                 card stroke, as a dialog's command space is. -->
            <Style x:Key="FooterStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <!--
                The type ramp: one style per role, each a step of Fluent's ramp (Caption 12, Body 14,
                Body Large 18, Subtitle 20, Title 28, Title Large 40) by its resource, so a role is
                changed in one place and no page decides a size of its own. No text is smaller than
                Caption. DesignTypographyTests holds the pages to these styles and these setters to
                the ramp. A row's name is BodyStrongTextBlockStyle, and a row's figure is RowFigure,
                which is never larger or heavier than the name, so the eye reads what a number is for
                before the number.
            -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource SubtitleTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- The heading of a card that sits beside other cards in one section, such as Explore's. -->
            <Style x:Key="CardHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeStrongTextBlockStyle}">
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
            </Style>

            <!-- The heading of a group of rows within a section, such as each group of settings. -->
            <Style x:Key="GroupHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Secondary text a step down: a row's detail, a note under a control, a count. -->
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
            </Style>

            <!-- A sentence that reports a §5.6 failure. Colour only reinforces the words, which say
                 it outright, because §6.5 forbids a claim that needs the colour to read. -->
            <Style x:Key="CriticalStatement" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- A line of secondary text nobody sees, laid in the same cell as a line that comes and
                 goes, so the cell is always one line high at the reader's own text size. A MinHeight
                 in pixels cannot do that: an empty TextBlock measures nothing, the line it reserved
                 for was a pixel short at 100% text and further short at every larger size, and
                 naming a shape then resized the map above it. Text sets how many lines it holds
                 open. -->
            <Style x:Key="LineStrut" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Text" Value="Ag" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>

            <!-- The label above a figure: small, letter-spaced and quiet, so the number carries. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- A figure in a list row, at the size of the row's name and lighter than it. -->
            <Style x:Key="RowFigure" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
            </Style>

            <!-- A figure in a card's summary, under or beside its FieldLabel. -->
            <Style x:Key="Figure" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="{StaticResource BodyLargeTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- The figures that stand beside a HeroFigure and qualify it. -->
            <Style x:Key="LargeFigure" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
            </Style>

            <!-- The one number a page exists to show. -->
            <Style x:Key="HeroFigure" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                <Setter Property="FontSize" Value="{StaticResource TitleLargeTextBlockFontSize}" />
                <Setter Property="LineHeight" Value="52" />
            </Style>

            <!--
                Glyph sizes, each named for the text a glyph sits beside, so an icon keeps its
                proportion to its label when either changes.
            -->
            <x:Double x:Key="GlyphSizeCompact">10</x:Double>
            <x:Double x:Key="GlyphSizeCaption">12</x:Double>
            <x:Double x:Key="GlyphSizeBody">14</x:Double>
            <x:Double x:Key="GlyphSizeStandard">16</x:Double>
            <x:Double x:Key="GlyphSizeLarge">20</x:Double>
            <x:Double x:Key="GlyphSizeEmptyState">44</x:Double>

            <!-- The parts of EmptyState, the banner a list or a picture shows in place of its contents. -->
            <Style x:Key="EmptyStateGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="{StaticResource GlyphSizeEmptyState}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>

            <Style x:Key="EmptyStateTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeStrongTextBlockStyle}">
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="EmptyStateMessage" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <!--
                Every button that offers to restart Deguffer as administrator, on every page, so the
                offer looks the same wherever it is made. DesignElevateButtonTests holds every such
                button to it.

                A whole template, because a Style cannot set the lightweight-styling keys the default
                Button template reads in its PointerOver and Pressed states: with only Background and
                BorderBrush set, the tint vanished under the pointer. This is DefaultButtonStyle's
                template with the elevation brushes in those states. Disabled keeps the SDK's own.
            -->
            <Style x:Key="ElevateButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ElevateButtonBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ElevateButtonBorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              Foreground="{TemplateBinding Foreground}"
                                              BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ElevateButtonBackgroundPointerOver}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ElevateButtonBorderBrushPointerOver}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ElevateButtonBackgroundPressed}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ElevateButtonBorderBrushPressed}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonBorderBrushDisabled}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A Storage row's container, in the list and in the group folded below it. The row
                 draws its own padding and divider, and its own controls are the tab stops, so the
                 container adds no space and is not a stop of its own. -->
            <Style x:Key="FindingRowContainer" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>

            <!-- The hairline between findings, and between a page's regions. -->
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!--
                The size bar on a finding row: slim, unlabelled, and never the only place a number
                appears. It exists so the relative weight of the rows is visible without reading
                every figure — §6.5 forbids encoding meaning where only the graphic carries it, so
                the size beside it always says the same thing in words. Hidden from assistive
                technology for that reason, as every FillBar is; the text is what gets announced.
            -->
            <Style x:Key="ShareBar" TargetType="controls:FillBar">
                <Setter Property="Height" Value="3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
