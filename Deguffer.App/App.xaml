<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Deguffer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deguffer.App"
    xmlns:controls="using:Deguffer.App.Controls"
    xmlns:converters="using:Deguffer.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- The drive picker's two ways of drawing a drive, for Explore and Duplicates. -->
                <controls:DriveTemplates />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The brushes of a button that restarts Deguffer as administrator: a warm, quiet tint, so
                the offer is noticed beside the plain buttons around it without reading as the page's
                primary action (the accent) or as a failure (critical red). The label says what the
                button does, so the tint only draws the eye to it (§6.5).

                Default (dark) and Light repeat their keys because ThemeDictionaries cannot share an
                entry between two themes. High Contrast takes the ordinary button's brushes, so the
                user's chosen contrast colours and borders are kept.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ElevateButtonBackground" Color="#3A2A1B" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPointerOver" Color="#46321E" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPressed" Color="#322519" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrush" Color="#9A5A22" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPointerOver" Color="#B86C2A" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPressed" Color="#86501F" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ElevateButtonBackground" Color="#FDF1E4" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPointerOver" Color="#FBE7D1" />
                    <SolidColorBrush x:Key="ElevateButtonBackgroundPressed" Color="#F7DCBE" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrush" Color="#E6A066" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPointerOver" Color="#DA8A44" />
                    <SolidColorBrush x:Key="ElevateButtonBorderBrushPressed" Color="#C97A36" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ElevateButtonBackground" ResourceKey="ButtonBackground" />
                    <StaticResource x:Key="ElevateButtonBackgroundPointerOver" ResourceKey="ButtonBackgroundPointerOver" />
                    <StaticResource x:Key="ElevateButtonBackgroundPressed" ResourceKey="ButtonBackgroundPressed" />
                    <StaticResource x:Key="ElevateButtonBorderBrush" ResourceKey="ButtonBorderBrush" />
                    <StaticResource x:Key="ElevateButtonBorderBrushPointerOver" ResourceKey="ButtonBorderBrushPointerOver" />
                    <StaticResource x:Key="ElevateButtonBorderBrushPressed" ResourceKey="ButtonBorderBrushPressed" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <converters:TierChipStyleConverter x:Key="TierChipStyle" />
            <converters:RunStatementStyleConverter x:Key="RunStatementStyle" />
            <converters:StandingChipStyleConverter x:Key="StandingChipStyle" />
            <converters:StartupChipStyleConverter x:Key="StartupChipStyle" />
            <converters:DriveVerdictChipStyleConverter x:Key="DriveVerdictChipStyle" />
            <converters:AttributeStandingChipStyleConverter x:Key="AttributeStandingChipStyle" />

            <!--
                §7's "colour by tier". These are Styles rather than loose brushes so the colours
                live in XAML as ThemeResource references: each element resolves them itself and
                re-resolves on a light/dark switch, which a brush handed over from C# cannot do.
                Shared by the finding rows and the tier reference on the About page, so the two
                cannot drift apart.
            -->
            <Style x:Key="TierChipBase" TargetType="ContentControl">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="9,2" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />

                <!-- ContentControl's default template is bare — it presents content and draws no
                     chrome at all, so Background, CornerRadius and Padding are ignored without
                     this. The template binds them instead of baking in colours, which is what
                     keeps the tier brushes in the per-tier styles below. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <!-- The chip itself is what a screen reader reads, because that
                                     is what carries the tier's explanation as help text. The
                                     label inside it is the same words again, so it is kept out of
                                     the accessibility tree rather than announced twice — which
                                     means every chip has to set AutomationProperties.Name, or it
                                     is announced with no name at all. -->
                                <ContentPresenter AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TierChipRegenerableCache" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>

            <Style x:Key="TierChipRegenerableWithCost" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <Style x:Key="TierChipUserData" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>

            <Style x:Key="TierChipDoNotTouch" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- An installed app's standing, on the tier chip's shape. Neutral, because a standing is
                 a finding rather than a warning, except where nothing could prove it either way. -->
            <Style x:Key="StandingChip" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A researched provider's chip (ProviderBasis). Neutral, because it qualifies the row
                 rather than warning about it, and caution's amber is Tier 2's. -->
            <Style x:Key="BasisChip" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="StandingChipUnproven" TargetType="ContentControl" BasedOn="{StaticResource TierChipBase}">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>

            <!--
                §6.5: colours come from theme brushes so they stay legible over unpredictable
                desktop content, in light and dark, and with the backdrop absent entirely.
            -->
            <Thickness x:Key="CardPadding">20</Thickness>
            <CornerRadius x:Key="CardCorner">8</CornerRadius>

            <!--
                One card per region, not one per row. Giving the free-space figure, the status
                line, every finding and the buttons an identical border made nothing more
                important than anything else, so the eye had no entry point. Weight now comes from
                type size and spacing; the card is only the surface holding a region together.
            -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- A line of secondary text nobody sees, laid in the same cell as a line that comes and
                 goes, so the cell is always one line high at the reader's own text size. A MinHeight
                 in pixels cannot do that: an empty TextBlock measures nothing, the line it reserved
                 for was a pixel short at 100% text and further short at every larger size, and
                 naming a shape then resized the map above it. Text sets how many lines it holds
                 open. -->
            <Style x:Key="LineStrut" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="Text" Value="Ag" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>

            <!-- A card's own sentence about what it is showing, under the figures rather than beside
                 them: it is a statement, not a value, and it has room to wrap. -->
            <Style x:Key="CardStatement" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- The same sentence when it reports a §5.6 failure. Colour only reinforces the words,
                 which say it outright, because §6.5 forbids a claim that needs the colour to read. -->
            <Style x:Key="CardStatementCritical" TargetType="TextBlock" BasedOn="{StaticResource CardStatement}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- The label above a figure: small, letter-spaced and quiet, so the number carries. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Figure" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="HeroFigure" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="LineHeight" Value="40" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!--
                Every button that offers to restart Deguffer as administrator, on every page, so the
                offer looks the same wherever it is made. DesignElevateButtonTests holds every such
                button to it.

                A whole template, because a Style cannot set the lightweight-styling keys the default
                Button template reads in its PointerOver and Pressed states: with only Background and
                BorderBrush set, the tint vanished under the pointer. This is DefaultButtonStyle's
                template with the elevation brushes in those states. Disabled keeps the SDK's own.
            -->
            <Style x:Key="ElevateButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ElevateButtonBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ElevateButtonBorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              Foreground="{TemplateBinding Foreground}"
                                              BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ElevateButtonBackgroundPointerOver}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ElevateButtonBorderBrushPointerOver}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ElevateButtonBackgroundPressed}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ElevateButtonBorderBrushPressed}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonBorderBrushDisabled}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The hairline between findings, and between a page's regions. -->
            <Style x:Key="Divider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <!--
                The size bar on a finding row: slim, unlabelled, and never the only place a number
                appears. It exists so the relative weight of the rows is visible without reading
                every figure — §6.5 forbids encoding meaning where only the graphic carries it, so
                the size beside it always says the same thing in words. Hidden from assistive
                technology for that reason, as every FillBar is; the text is what gets announced.
            -->
            <Style x:Key="ShareBar" TargetType="controls:FillBar">
                <Setter Property="Height" Value="3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
