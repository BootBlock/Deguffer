<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      §6.1: Core carries no UI dependency but still targets net10.0-windows — the scanner
      P/Invokes Win32, so there is no meaningful portable subset to preserve.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Deguffer.Core</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Required by [LibraryImport], which generates the marshalling for the one raw volume handle
      the MFT scanner opens (§5.5). No hand-written unsafe code exists in this project.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Two rules are internal because nothing outside Core has any business calling them, and both
      are pure functions a test is better off asking directly.

      LiveTreeInspector.Filtered decides which rows of the process table count as evidence. Driving
      it from outside would mean starting a second process at this one's own image path, and a test
      cannot arrange that. There is no route to the case that matters except this one.

      DirectoryAge is one age rule with four callers. It is reachable through any of them, so this
      is a choice rather than a necessity: a rule stated once should be held to once, not
      re-asserted four times through providers whose own subject is something else.

      This grant is not a licence to reach past a public seam. Where the consequence is testable
      from outside, it is tested from outside - see the class comment on LiveTreeInspectorTests.
    -->
    <InternalsVisibleTo Include="Deguffer.Core.Tests" />
  </ItemGroup>

</Project>
